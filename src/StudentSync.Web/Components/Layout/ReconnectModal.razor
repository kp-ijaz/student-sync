<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

@* Shown by Blazor while the live connection to the server is restored (on phones: after the screen was locked or the app
   was in the background). Nothing is shown for a quick reconnect; after a moment a light shimmer sweeps over the page
   (taps wait until the connection is back). Only when the device is really offline does a small card offer Try again.
   Behaviour: ReconnectModal.razor.js. Styles: "Reconnect" block in wwwroot/css/app.css. *@
<dialog id="components-reconnect-modal" class="reconnect" data-nosnippet aria-label="Connection">
    <div class="reconnect-veil" aria-hidden="true"></div>
    <div class="reconnect-bar" aria-hidden="true"></div>
    <p class="sr-only" role="status" aria-live="polite">
        <span class="components-reconnect-first-attempt-visible components-reconnect-repeated-attempt-visible components-pause-visible">Reconnecting…</span>
        <span class="components-reconnect-failed-visible">You seem to be offline.</span>
    </p>
    <div class="reconnect-card components-reconnect-failed-visible">
        <div class="reconnect-text">
            <p class="reconnect-title">You seem to be offline</p>
            <p class="reconnect-sub">Check your internet connection. We'll reconnect as soon as it's back.</p>
        </div>
        <button id="components-reconnect-button" type="button" class="btn btn-primary btn-sm">Try again</button>
    </div>
    @* Blazor looks these up by id; they are not shown. *@
    <span id="components-seconds-to-next-attempt" hidden></span>
    <button id="components-resume-button" type="button" hidden tabindex="-1">Reload</button>
</dialog>
