@page "/salary-slips/{TeacherId:guid}/{PaymentId:guid}"
@inherits AppPage
@* Printable salary slip (admins, and the teacher it belongs to — the API refuses anyone else). *@
<PageTitle>Salary slip · Student Sync</PageTitle>
<DataView Loading="_s is null && _error is null" Error="_error" OnRetry="LoadAsync">
    @if (_s is { } s)
    {
        <div class="doc-actions no-print"><button class="btn btn-primary" onclick="window.print()"><Icon Name="download" /> Print or save as PDF</button></div>
        <article class="doc card" aria-labelledby="ss-h">
            <header class="doc-head">
                <div><h1 id="ss-h">Salary slip</h1><div class="caption">No. @s.Number</div></div>
                <div class="doc-from"><strong>@s.InstituteName</strong>@if (s.InstituteEmail is { } e) { <div class="caption">@e</div> }</div>
            </header>
            @if (s.Voided) { <div class="error-panel" role="status"><strong>This payment was removed:</strong> @s.VoidReason</div> }
            <dl class="doc-grid">
                <dt>Paid to</dt><dd>@s.TeacherName</dd>
                <dt>Date</dt><dd>@s.PaidOn.ToString("d MMMM yyyy")</dd>
                @if (s.PeriodFrom is { } f && s.PeriodTo is { } t) { <dt>For</dt><dd>@f.ToString("d MMM") – @t.ToString("d MMM yyyy")</dd> }
                @if (s.HoursInPeriod is { } h) { <dt>Hours taught</dt><dd>@Money.Hours(h)</dd> }
                <dt>Paid by</dt><dd>@(s.Method == "BankTransfer" ? "Bank transfer" : s.Method == "Upi" ? "UPI" : s.Method)@(s.Reference is { } x ? $" · {x}" : "")</dd>
                @if (s.Note is { } n) { <dt>Note</dt><dd>@n</dd> }
            </dl>
            <div class="doc-total"><span>Amount paid</span><strong>@Money.Format(s.Amount, s.CurrencyCode)</strong></div>
            <footer class="caption doc-foot">Generated by Student Sync.</footer>
        </article>
    }
</DataView>

@code {
    [Parameter] public Guid TeacherId { get; set; }
    [Parameter] public Guid PaymentId { get; set; }
    private SalarySlipDto? _s;
    private ApiException? _error;
    protected override async Task LoadAsync() => (_s, _error) = await Fetch(() => Api.GetAsync<SalarySlipDto>($"teachers/{TeacherId}/pay/payments/{PaymentId}/slip"));
}
