# Copy to api.env on the API VM (chmod 600). Never commit the real file.
# Azure SQL: use a database-scoped login, not the server admin. The retry settings let the first request
# after an auto-pause wait for the serverless database to resume instead of failing.
ConnectionStrings__Default=Server=tcp:<server>.database.windows.net,1433;Database=StudentSync;User Id=<app-user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connect Timeout=120;ConnectRetryCount=10;ConnectRetryInterval=10
# At least 32 random characters, e.g. `openssl rand -base64 48`.
Jwt__SigningKey=
# Origin of the web app (browser clients calling the API directly).
Cors__Origins__0=https://<app-host>
