@page "/change-password"
@attribute [Authorize]
@inherits AppPage

<PageHeader Title="Change your password" Subtitle="Choose a new password to continue. Use at least 10 characters with upper- and lower-case letters and a number." />
<div class="card" style="max-width:520px">
    @if (Me?.MustChangePassword == true) { <div class="warn-panel" style="margin-bottom:16px">You're using a temporary password. Please set your own before continuing.</div> }
    <EditForm Model="_model" OnValidSubmit="Save" FormName="change-password">
        <div class="stack">
            <div class="field"><label for="cur">Current password</label><InputText id="cur" type="password" class="input" @bind-Value="_model.Current" autocomplete="current-password" /></div>
            <div class="field"><label for="new">New password</label><InputText id="new" type="password" class="input" @bind-Value="_model.New" autocomplete="new-password" /></div>
            <div class="field"><label for="confirm">Confirm new password</label><InputText id="confirm" type="password" class="input" @bind-Value="_model.Confirm" autocomplete="new-password" />
                @if (_mismatch) { <span class="error">The passwords don't match.</span> }</div>
            <div class="form-actions"><button class="btn btn-primary" type="submit" disabled="@Busy">Update password</button></div>
        </div>
    </EditForm>
</div>

@code {
    private sealed class Model { public string Current { get; set; } = ""; public string New { get; set; } = ""; public string Confirm { get; set; } = ""; }
    private readonly Model _model = new();
    private bool _mismatch;

    private async Task Save()
    {
        _mismatch = _model.New != _model.Confirm;
        if (_mismatch || Me is null) return;
        var ok = await Run(async () =>
        {
            await Api.PostAsync("me/password", new ChangePasswordRequest(_model.Current, _model.New));
            // The API revokes every session on password change; sign this session in again with the new password.
            var fresh = await Api.LoginAsync(new LoginRequest(Me.Email, _model.New, null, "web"));
            await Api.ReplaceTokensAsync(fresh);
        }, "Password updated.");
        if (ok) Nav.NavigateTo(Navigation.Home(Me.Role), forceLoad: true);
    }
}
