@* One card of key numbers separated by hairlines (DESIGN.md "Home pattern"), instead of a grid of separate stat cards.
   Each cell: icon + label, the value, and a short note that says what the number counts. Cells with a link open the
   page where that number is managed. Two columns on phones; an odd last cell spans both. *@
<section class="metric-strip @Class" aria-label="@AriaLabel" style="--n:@Math.Max(1, Items.Count)">
    @foreach (var m in Items)
    {
        if (m.Href is not null)
        {
            <a class="metric-cell" href="@m.Href">@Body(m)</a>
        }
        else
        {
            <div class="metric-cell">@Body(m)</div>
        }
    }
</section>

@code {
    public sealed record Item(string Label, string Value, string Note, string Icon, string? Href = null);

    [Parameter, EditorRequired] public IReadOnlyList<Item> Items { get; set; } = [];
    [Parameter] public string AriaLabel { get; set; } = "At a glance";
    [Parameter] public string? Class { get; set; }

    private static RenderFragment Body(Item m) =>
        @<text><span class="metric-strip-label"><Icon Name="@m.Icon" />@m.Label</span><strong>@m.Value</strong><span class="metric-strip-note">@m.Note</span></text>;
}
