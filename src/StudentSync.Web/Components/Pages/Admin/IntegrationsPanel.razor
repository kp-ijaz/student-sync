@inherits AppComponent

@* Settings ▸ Integrations (institution admins): the institute's own email server, SMS provider and payment gateway.
   Secrets are write-only: the API only says whether one is saved; leaving a secret box empty keeps the saved one. Every
   "test"/"verify" makes a real call and shows the provider's answer. *@
<DataView Loading="_d is null && _error is null" Error="_error" OnRetry="Load">
    @if (_d is not null)
    {
        <div class="stack integrations">
            @* ---------------- Email ---------------- *@
            <section class="card" aria-labelledby="int-email">
                <div class="int-head">
                    <IconTile Icon="mail" Tone="blue" Size="md" />
                    <div class="grow"><h2 id="int-email">Email (SMTP)</h2>
                        <p class="caption">Class changes, assignments, results and other notifications are emailed through this server.</p></div>
                    <StatusChip Enabled="_d.Email.Enabled" Check="_d.Email.LastCheck" />
                </div>
                @if (!_d.Email.Enabled) { <p class="int-note">@(_d.ServerEmailConfigured ? "Off: emails go out through Student Sync's own server for now." : "Off: no email is sent until an SMTP server is switched on here.")</p> }
                <label class="check"><input type="checkbox" @bind="_eOn" /> Send email through our own server</label>
                <div class="form-grid">
                    <div class="field"><label for="eh">SMTP server</label><input id="eh" class="input" placeholder="smtp.gmail.com" autocomplete="off" @bind="_eHost" /></div>
                    <div class="field int-port"><label for="ep">Port</label><input id="ep" class="input" type="number" min="1" max="65535" @bind="_ePort" /></div>
                    <div class="field"><label for="es">Security</label>
                        <select id="es" class="select" @bind="_eSecurity"><option value="starttls">STARTTLS (port 587)</option><option value="auto">SSL/TLS or automatic (port 465, or no encryption)</option></select></div>
                    <div class="field"><label for="eu">Username</label><input id="eu" class="input" autocomplete="off" placeholder="Usually the full email address" @bind="_eUser" /></div>
                    <div class="field"><label for="epw">Password or app password</label><input id="epw" class="input" type="password" autocomplete="new-password" placeholder="@(_d.Email.HasPassword ? "Saved — leave blank to keep" : "")" @bind="_ePass" /></div>
                    <div class="field"><label for="ef">Send from (email)</label><input id="ef" class="input" type="email" placeholder="office@yourcentre.com" @bind="_eFrom" /></div>
                    <div class="field"><label for="efn">Sender name</label><input id="efn" class="input" placeholder="Your institute's name" @bind="_eFromName" /></div>
                </div>
                <div class="form-actions"><button class="btn btn-primary" @onclick="SaveEmail" disabled="@Busy">Save email settings</button></div>
                <TestRow Label="Send a test email to" Type="email" Placeholder="you@example.com" @bind-Value="_eTo" Button="Send test email" OnTest="TestEmail" Busy="Busy" Check="_d.Email.LastCheck" Tz="@Tz" />
            </section>

            @* ---------------- SMS ---------------- *@
            <section class="card" aria-labelledby="int-sms">
                <div class="int-head">
                    <IconTile Icon="message" Tone="green" Size="md" />
                    <div class="grow"><h2 id="int-sms">SMS</h2>
                        <p class="caption">Text messages to students and families, sent by the automations you switch on in Settings ▸ Automations (absences, fees, hours, class days, progress reports).</p></div>
                    <StatusChip Enabled="_d.Sms.Enabled" Check="_d.Sms.LastCheck" />
                </div>
                <Segmented TValue="SmsProvider" Label="SMS provider" Options="@([new(SmsProvider.Twilio, "Twilio"), new(SmsProvider.Msg91, "MSG91 (India)")])" @bind-Value="_sProvider" />
                <p class="int-note">@(_sProvider == SmsProvider.Twilio ? "Twilio works in the UAE, India and most countries. Find the Account SID and Auth Token on the Twilio console home page." : "MSG91 sends in India with a DLT-approved sender ID and template. The template must have one variable, VAR1, for the message text.")</p>
                <label class="check"><input type="checkbox" @bind="_sOn" /> Use this SMS provider</label>
                <div class="form-grid">
                    @if (_sProvider == SmsProvider.Twilio)
                    {
                        <div class="field"><label for="sa">Account SID</label><input id="sa" class="input" autocomplete="off" placeholder="AC…" @bind="_sAccount" /></div>
                        <div class="field"><label for="ss">Send from</label><input id="ss" class="input" autocomplete="off" placeholder="+1… number or MG… service SID" @bind="_sSender" /></div>
                        <div class="field"><label for="sk">Auth Token</label><input id="sk" class="input" type="password" autocomplete="new-password" placeholder="@(_d.Sms.HasSecret && _d.Sms.Provider == _sProvider ? "Saved — leave blank to keep" : "")" @bind="_sSecret" /></div>
                    }
                    else
                    {
                        <div class="field"><label for="sk2">Auth key</label><input id="sk2" class="input" type="password" autocomplete="new-password" placeholder="@(_d.Sms.HasSecret && _d.Sms.Provider == _sProvider ? "Saved — leave blank to keep" : "")" @bind="_sSecret" /></div>
                        <div class="field"><label for="st">Template (flow) ID</label><input id="st" class="input" autocomplete="off" @bind="_sTemplate" /></div>
                        <div class="field"><label for="ss2">Sender ID (optional)</label><input id="ss2" class="input" maxlength="6" placeholder="6 letters" @bind="_sSender" /></div>
                    }
                </div>
                @if (_d.Sms.Provider != _sProvider && _d.Sms.HasSecret) { <p class="int-note warn">Saving with @_sProvider replaces the saved @_d.Sms.Provider settings.</p> }
                <div class="form-actions"><button class="btn btn-primary" @onclick="SaveSms" disabled="@Busy">Save SMS settings</button></div>
                <TestRow Label="Send a test SMS to" Type="tel" Placeholder="+971 50 123 4567" @bind-Value="_sTo" Button="Send test SMS" OnTest="TestSms" Busy="Busy" Check="_d.Sms.LastCheck" Tz="@Tz" />
            </section>

            @* ---------------- Payments ---------------- *@
            <section class="card" aria-labelledby="int-pay">
                <div class="int-head">
                    <IconTile Icon="wallet" Tone="violet" Size="md" />
                    <div class="grow"><h2 id="int-pay">Online payments</h2>
                        <p class="caption">Families pay fees through a payment link (from a student's Fees tab, or attached to fee reminders). Paid links are recorded automatically as “Online” payments with a receipt.</p></div>
                    <StatusChip Enabled="_d.Payments.Enabled" Check="_d.Payments.LastCheck" />
                </div>
                <Segmented TValue="PaymentProvider" Label="Payment gateway" Options="@([new(PaymentProvider.Razorpay, "Razorpay (India)"), new(PaymentProvider.Stripe, "Stripe (UAE)")])" @bind-Value="_pProvider" />
                <p class="int-note">@(_pProvider == PaymentProvider.Razorpay ? "Razorpay takes INR by UPI, cards and net banking. Keys are under Account & Settings ▸ API Keys." : "Stripe takes cards in AED and other currencies. Keys are under Developers ▸ API keys.") Start with test keys; switch to live keys when you are ready.</p>
                <label class="check"><input type="checkbox" @bind="_pOn" /> Use this gateway</label>
                <div class="form-grid">
                    <div class="field"><label for="pk">@(_pProvider == PaymentProvider.Razorpay ? "Key ID" : "Publishable key")</label><input id="pk" class="input" autocomplete="off" placeholder="@(_pProvider == PaymentProvider.Razorpay ? "rzp_test_…" : "pk_test_…")" @bind="_pKey" /></div>
                    <div class="field"><label for="ps">@(_pProvider == PaymentProvider.Razorpay ? "Key secret" : "Secret key")</label><input id="ps" class="input" type="password" autocomplete="new-password" placeholder="@(_d.Payments.HasSecret && _d.Payments.Provider == _pProvider ? "Saved — leave blank to keep" : "")" @bind="_pSecret" /></div>
                    <div class="field"><label for="pw">Webhook secret (optional)</label><input id="pw" class="input" type="password" autocomplete="new-password" placeholder="@(_d.Payments.HasWebhookSecret && _d.Payments.Provider == _pProvider ? "Saved — leave blank to keep" : _pProvider == PaymentProvider.Stripe ? "whsec_…" : "")" @bind="_pWebhook" /></div>
                </div>
                @if (_d.Payments.Mode is { } mode && _d.Payments.Provider == _pProvider) { <p class="int-note">Saved keys are <strong>@mode</strong> keys@(mode == "test" ? ": no real money moves." : ": real payments.")</p> }
                @if (_d.Payments.Provider != _pProvider && _d.Payments.HasSecret) { <p class="int-note warn">Saving with @_pProvider replaces the saved @_d.Payments.Provider keys.</p> }
                @if (_slug is not null)
                {
                    <div class="int-note">
                        <strong>Webhook (recommended):</strong> in your @_pProvider dashboard add this URL and the event
                        <code>@(_pProvider == PaymentProvider.Razorpay ? "payment_link.paid" : "checkout.session.completed")</code>, then paste its signing secret above.
                        <div class="row" style="flex-wrap:nowrap;margin-top:6px"><input class="input grow" readonly aria-label="Webhook URL" onfocus="this.select()"
                            value="@($"{Config["Api:PublicBaseUrl"]?.TrimEnd('/')}/api/v1/webhooks/payments/{_pProvider.ToString().ToLowerInvariant()}/{_slug}")" /></div>
                        <span class="caption">Without a webhook, payments are still picked up by a check every 15 minutes.</span>
                    </div>
                }
                <div class="form-actions"><button class="btn btn-primary" @onclick="SavePayments" disabled="@Busy">Save payment settings</button></div>
                <div class="int-test">
                    <button class="btn btn-secondary" @onclick="VerifyPayments" disabled="@Busy"><Icon Name="shield" /> Verify keys with @_d.Payments.Provider</button>
                    <CheckLine Check="_d.Payments.LastCheck" Tz="@Tz" />
                </div>
            </section>

            <details class="card int-platform">
                <summary><strong>Services run by Student Sync</strong> <span class="caption">AI, push notifications, transcription and the server's own email</span></summary>
                <ul class="list">@foreach (var i in Platform) { <li class="row-between"><div><strong>@i.Name</strong><div class="caption">@i.Detail</div></div><span class="badge @(i.Configured ? "green" : "slate")">@(i.Configured ? "Configured" : "Not configured")</span></li> }</ul>
            </details>
        </div>
    }
</DataView>

@code {
    [Parameter] public IReadOnlyList<IntegrationStatusDto> Platform { get; set; } = [];
    private InstitutionIntegrationsDto? _d;
    private ApiException? _error;
    // Email
    private bool _eOn;
    private string _eSecurity = "starttls"; // a text value: a select bound straight to a bool did not round-trip
    private int _ePort = 587;
    private string? _eHost, _eUser, _ePass, _eFrom, _eFromName, _eTo;
    // SMS
    private bool _sOn;
    private SmsProvider _sProvider;
    private string? _sAccount, _sSender, _sTemplate, _sSecret, _sTo;
    // Payments
    private bool _pOn;
    private PaymentProvider _pProvider;
    private string? _pKey, _pSecret, _pWebhook;

    protected override Task OnInitializedAsync() => Load();

    [Inject] private IConfiguration Config { get; set; } = default!;
    private string? _slug;

    private async Task Load()
    {
        (_d, _error) = await Fetch(() => Api.GetAsync<InstitutionIntegrationsDto>("institution/connections"));
        if (_d is null) return;
        _slug ??= (await Fetch(() => Api.GetAsync<InstitutionSettingsDto>("institution/settings"))).Value?.Slug;
        var e = _d.Email;
        (_eOn, _eHost, _ePort, _eSecurity, _eUser, _eFrom, _eFromName, _ePass) = (e.Enabled, e.Host, e.Port, e.UseStartTls ? "starttls" : "auto", e.Username, e.FromAddress, e.FromName, null);
        _eTo ??= Me.Email;
        var s = _d.Sms;
        (_sOn, _sProvider, _sAccount, _sSender, _sTemplate, _sSecret) = (s.Enabled, s.Provider, s.AccountId, s.Sender, s.TemplateId, null);
        var p = _d.Payments;
        (_pOn, _pProvider, _pKey, _pSecret, _pWebhook) = (p.Enabled, p.Provider, p.KeyId, null, null);
    }

    private async Task SaveEmail()
    {
        if (await Run(() => Api.PutAsync("institution/connections/email", new SaveEmailIntegrationRequest(_eOn, _eHost, _ePort, _eSecurity == "starttls", _eUser, _ePass, _eFrom, _eFromName)), "Email settings saved."))
            await Load();
    }

    private async Task SaveSms()
    {
        if (await Run(() => Api.PutAsync("institution/connections/sms", new SaveSmsIntegrationRequest(_sOn, _sProvider, _sAccount, _sSender, _sTemplate, _sSecret)), "SMS settings saved."))
            await Load();
    }

    private async Task SavePayments()
    {
        if (await Run(() => Api.PutAsync("institution/connections/payments", new SavePaymentIntegrationRequest(_pOn, _pProvider, _pKey, _pSecret, _pWebhook)), "Payment settings saved."))
            await Load();
    }

    private Task TestEmail() => Check(() => Api.PostAsync<IntegrationCheckDto>("institution/connections/email/test", new TestEmailRequest(_eTo ?? "")));
    private Task TestSms() => Check(() => Api.PostAsync<IntegrationCheckDto>("institution/connections/sms/test", new TestSmsRequest(_sTo ?? "")));
    private Task VerifyPayments() => Check(() => Api.PostAsync<IntegrationCheckDto>("institution/connections/payments/verify", null));

    // The result shows on the card (green or red line); the toast repeats it for screen readers.
    private async Task Check(Func<Task<IntegrationCheckDto>> call)
    {
        IntegrationCheckDto? result = null;
        if (await Run(async () => result = await call()) && result is not null)
        {
            Toasts.Show(result.Message, result.Ok ? ToastKind.Success : ToastKind.Error);
            await Load();
        }
    }
}
