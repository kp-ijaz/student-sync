@implements IDisposable
@inject ToastService Service

<div class="toasts" role="status" aria-live="polite">
    @foreach (var t in Service.Items)
    {
        <div class="toast @(t.Kind == ToastKind.Error ? "error" : t.Kind == ToastKind.Success ? "success" : "")">
            <span>@t.Message</span>
            <button aria-label="Dismiss" @onclick="() => Service.Dismiss(t.Id)">×</button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Service.Changed += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Service.Changed -= Refresh;
}
