@page "/admin/finance"
@attribute [Authorize(Roles = "InstitutionAdmin")]
@inherits AppPage
@inject IJSRuntime JS

@* Fees ▸ Finance (owner requests 2026-11-24): the centre's money in one place, cash basis (money counts on the day it was
   received or paid). Top to bottom: the period → totals with the change from the period before → where the money went
   and the last 12 months → every transaction (search, type, category, sort, pages, CSV) → money still open with people
   who left. Every line can be edited or deleted here (expenses with their form, fee and salary payments with PaymentEditor); salaries use the same dialog as Fees ▸ Salaries and the teacher's
   page; fee receipts and salary slips open from each line. Links can preset the view: ?kind=Salary&from=…&to=… *@
<PageTitle>Finance · Student Sync</PageTitle>
<PageHeader Title="Finance" Subtitle="Money in and out: fees received, salaries paid and running costs, and what is left as profit.">
    <Actions>
        <button class="btn btn-secondary" @onclick="ExportCsv" disabled="@Busy"><Icon Name="download" /> Export</button>
        <button class="btn btn-secondary" @onclick="OpenSalary"><Icon Name="users" /> Record salary</button>
        <button class="btn btn-primary" @onclick="NewExpense"><Icon Name="plus" /> Add expense</button>
    </Actions>
</PageHeader>

@* 1. Period *@
<PeriodSwitcher Period="@_period" From="_from" To="_to" AllowDates="true" Changed="PeriodChanged" />

<DataView Loading="_s is null && _error is null" Error="_error" OnRetry="LoadAll">
    @if (_s is { } s)
    {
        @* 2. Totals; each opens the matching transactions below. *@
        <div class="metric-strip finance-kpis" role="group" aria-label="Money at a glance" style="--n:4">
            <button type="button" class="metric-cell @(_kind == "Income" ? "on" : "")" aria-pressed="@Aria.Bool(_kind == "Income")" @onclick='() => SetKind("Income")'>
                <span class="metric-strip-label"><Icon Name="trending-up" /> Income</span><strong class="metric-value">@Money.Format(s.Income, s.CurrencyCode)</strong>
                <span class="metric-strip-note">fees received · @Periods.Change(s.Income, s.Previous.Income)</span></button>
            <button type="button" class="metric-cell @(_kind == "Salary" ? "on" : "")" aria-pressed="@Aria.Bool(_kind == "Salary")" @onclick='() => SetKind("Salary")'>
                <span class="metric-strip-label"><Icon Name="users" /> Salaries paid</span><strong class="metric-value">@Money.Format(s.Salaries, s.CurrencyCode)</strong>
                <span class="metric-strip-note">to teachers · @Periods.Change(s.Salaries, s.Previous.Salaries)</span></button>
            <button type="button" class="metric-cell @(_kind == "Expense" ? "on" : "")" aria-pressed="@Aria.Bool(_kind == "Expense")" @onclick='() => SetKind("Expense")'>
                <span class="metric-strip-label"><Icon Name="wallet" /> Expenses</span><strong class="metric-value">@Money.Format(s.Expenses, s.CurrencyCode)</strong>
                <span class="metric-strip-note">rent, bills, other · @Periods.Change(s.Expenses, s.Previous.Expenses)</span></button>
            <button type="button" class="metric-cell @(_kind == "all" ? "on" : "")" aria-pressed="@Aria.Bool(_kind == "all")" @onclick='() => SetKind("all")'>
                <span class="metric-strip-label"><Icon Name="@(s.Profit < 0 ? "alert" : "check-circle")" /> @(s.Profit < 0 ? "Loss" : "Profit")</span>
                <strong class="metric-value @(s.Profit < 0 ? "loss" : "")">@Money.Format(Math.Abs(s.Profit), s.CurrencyCode)</strong>
                <span class="metric-strip-note">income − salaries − expenses@(s.MarginPercent is { } mp ? $" · {mp:0.#}% of income" : "")</span></button>
        </div>
        <p class="caption finance-open">
            Before (@Periods.Name(s.Previous.From, s.Previous.To)): @(s.Previous.Profit < 0 ? "loss" : "profit") @Money.Format(Math.Abs(s.Previous.Profit), s.CurrencyCode).
            Open today: <a href="/admin/fees">@Money.Format(s.FeesToCollect, s.CurrencyCode) fees to collect</a> ·
            <a href="/admin/salaries">@Money.Format(s.SalariesOwed, s.CurrencyCode) salaries to pay</a>
        </p>

        @* 3. Where it went and the trend *@
        <div class="grid grid-2 finance-grid">
            <section class="card" aria-labelledby="cat-h">
                <div class="card-head"><h2 id="cat-h">Where the money went</h2><span class="caption">@PeriodLabel</span></div>
                @{ var outgoing = s.Salaries + s.Expenses; }
                @if (outgoing == 0) { <InlineEmpty Icon="wallet" Text="Nothing paid out in this period." /> }
                else
                {
                    <div class="finance-bars">
                        @if (s.Salaries > 0) { <button type="button" class="finance-bar-btn" @onclick='() => SetKind("Salary")'><FinanceBar Label="Salaries" Amount="s.Salaries" Total="outgoing" Currency="@s.CurrencyCode" /></button> }
                        @foreach (var c in s.ExpensesByCategory)
                        {
                            <button type="button" class="finance-bar-btn" @onclick="() => SetCategory(c.Category)"><FinanceBar Label="@FinanceLabels.Category(c.Category)" Amount="c.Amount" Total="outgoing" Currency="@s.CurrencyCode" /></button>
                        }
                    </div>
                    <p class="caption">Share of everything paid out (@Money.Format(outgoing, s.CurrencyCode)). Choose a line to see its transactions.</p>
                }
            </section>

            <section class="card" aria-labelledby="trend-h">
                <div class="card-head"><h2 id="trend-h">Last 12 months</h2><span class="caption">choose a month to open it</span></div>
                <div class="table-wrap"><table class="table stack-mobile finance-trend">
                    <thead><tr><th>Month</th><th class="num">Income</th><th class="num">Salaries</th><th class="num">Expenses</th><th class="num">Profit</th></tr></thead>
                    <tbody>@foreach (var m in s.Months.Reverse())
                    {
                        <tr class="@(m.Month == _from && _period == "month" ? "current" : "")">
                            <td data-label="Month"><button type="button" class="link-btn" @onclick="() => OpenMonth(m.Month)">@m.Month.ToString("MMM yyyy")</button></td>
                            <td data-label="Income" class="num">@Money.Format(m.Income, s.CurrencyCode)</td>
                            <td data-label="Salaries" class="num">@Money.Format(m.Salaries, s.CurrencyCode)</td>
                            <td data-label="Expenses" class="num">@Money.Format(m.Expenses, s.CurrencyCode)</td>
                            <td data-label="Profit" class="num @(m.Profit < 0 ? "loss" : "")">@(m.Profit < 0 ? "−" : "")@Money.Format(Math.Abs(m.Profit), s.CurrencyCode)</td></tr>
                    }</tbody>
                </table></div>
            </section>
        </div>
    }
</DataView>

@* 4. Transactions *@
<section class="card finance-tx" id="transactions" aria-labelledby="tx-h">
    <div class="card-head"><h2 id="tx-h">Transactions</h2><span class="caption">@PeriodLabel</span></div>
    <div class="list-tools finance-tools">
        <input class="input" type="search" placeholder="Search name, note, reference…" aria-label="Search transactions" @bind="_search" @bind:after="() => LoadEntries(1)" />
        <select class="select" aria-label="Expense category" @bind="_categoryText" @bind:after="CategoryChanged" disabled="@(_kind is "Income" or "Salary")">
            <option value="">All categories</option>
            @foreach (var c in Enum.GetValues<ExpenseCategory>()) { <option value="@c">@FinanceLabels.Category(c)</option> }
        </select>
        <select class="select" aria-label="Sort transactions" @bind="_sort" @bind:after="() => LoadEntries(1)">
            <option value="@FinanceSort.Newest">Newest first</option>
            <option value="@FinanceSort.Oldest">Oldest first</option>
            <option value="@FinanceSort.Largest">Largest amount</option>
            <option value="@FinanceSort.Smallest">Smallest amount</option>
        </select>
    </div>
    <PillTabs TKey="string" Tabs="Tabs" Active="_kind" ActiveChanged="SetKind" Label="Show">
        <DataView Loading="_e is null && _entriesError is null" Error="_entriesError" OnRetry="() => LoadEntries(_e?.Page.Page ?? 1)">
            @if (_e is { } e)
            {
                <p class="finance-filtered" role="status">
                    <span>@e.Page.TotalCount line@(e.Page.TotalCount == 1 ? "" : "s")</span>
                    <span class="in">In +@Money.Format(e.MoneyIn, Currency)</span>
                    <span class="out">Out −@Money.Format(e.MoneyOut, Currency)</span>
                    <span>Net @(e.Net < 0 ? "−" : "")@Money.Format(Math.Abs(e.Net), Currency)</span>
                    @if (Filtered) { <button type="button" class="link-btn" @onclick="ClearFilters">Clear filters</button> }
                </p>
                @if (e.Page.Items.Count == 0) { <InlineEmpty Icon="inbox" Text="@(Filtered ? "Nothing matches these filters." : "Nothing recorded in this period.")" /> }
                else
                {
                    <ul class="finance-ledger">
                        @foreach (var x in e.Page.Items)
                        {
                            <li>
                                <span class="finance-date">@x.Date.ToString("d MMM")@if (_period != "month") { <span class="caption">@x.Date.Year</span> }</span>
                                <span class="finance-kind @x.Kind.ToString().ToLowerInvariant()" title="@FinanceLabels.Kind(x.Kind)"><Icon Name="@KindIcon(x.Kind)" /></span>
                                <span class="grow">
                                    @if (x.PersonId is { } pid) { <a href="@(x.Kind == FinanceEntryKind.Income ? $"/students/{pid}#fees" : $"/teachers/{pid}#pay")"><strong>@x.Title</strong></a> }
                                    else { <strong>@x.Title</strong> }
                                    <span class="caption">@FinanceLabels.Kind(x.Kind)@(x.Detail is { } det ? $" · {det}" : "")@(x.Method is { } mt ? $" · {FinanceLabels.Method(mt)}" : "")@(x.Reference is { } rf ? $" · {rf}" : "")</span>
                                </span>
                                <span class="finance-amount @(x.Kind == FinanceEntryKind.Income ? "in" : "out")">@(x.Kind == FinanceEntryKind.Income ? "+" : "−")@Money.Format(x.Amount, Currency)</span>
                                <span class="finance-act">
                                    @switch (x.Kind)
                                    {
                                        case FinanceEntryKind.Income:
                                            <a class="icon-btn icon-btn-sm" href="/receipts/@x.RecordId" title="Receipt" aria-label="@($"Receipt for {x.Title}, {x.Date:d MMM}")"><Icon Name="file" /></a>
                                            @if (PaymentEditor.CanEdit(x.Method)) { <button type="button" class="icon-btn icon-btn-sm" title="Edit" aria-label="@($"Edit payment from {x.Title}, {x.Date:d MMM}")" @onclick="() => _editor?.Edit(x, Currency)"><Icon Name="pencil" /></button> }
                                            <button type="button" class="icon-btn icon-btn-sm" title="Delete" aria-label="@($"Delete payment from {x.Title}, {x.Date:d MMM}")" @onclick="() => _editor?.Remove(x, Currency)"><Icon Name="trash" /></button>
                                            break;
                                        case FinanceEntryKind.Salary:
                                            <a class="icon-btn icon-btn-sm" href="/salary-slips/@x.PersonId/@x.RecordId" title="Salary slip" aria-label="@($"Salary slip for {x.Title}, {x.Date:d MMM}")"><Icon Name="file" /></a>
                                            <button type="button" class="icon-btn icon-btn-sm" title="Edit" aria-label="@($"Edit salary payment to {x.Title}, {x.Date:d MMM}")" @onclick="() => _editor?.Edit(x, Currency)"><Icon Name="pencil" /></button>
                                            <button type="button" class="icon-btn icon-btn-sm" title="Delete" aria-label="@($"Delete salary payment to {x.Title}, {x.Date:d MMM}")" @onclick="() => _editor?.Remove(x, Currency)"><Icon Name="trash" /></button>
                                            break;
                                        default:
                                            <button type="button" class="icon-btn icon-btn-sm" title="Edit" aria-label="@($"Edit expense {x.Title}")" @onclick="() => EditExpense(x.RecordId)"><Icon Name="pencil" /></button>
                                            <button type="button" class="icon-btn icon-btn-sm" title="Delete" aria-label="@($"Delete expense {x.Title}")" @onclick="() => AskDelete(x)"><Icon Name="trash" /></button>
                                            break;
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                    <Pager Page="e.Page.Page" TotalPages="e.Page.TotalPages" Total="e.Page.TotalCount" OnPage="LoadEntries" />
                }
            }
        </DataView>
    </PillTabs>
</section>

@* 5. One line when money is still open with deleted people (their records are under Students / Teachers ▸ Deleted) *@
@if (Me is not null) { <FormerBalances Me="Me" Show="summary" /> }

<Modal @bind-Open="_open" Title="@(_editId is null ? "Add expense" : "Edit expense")">
    <Choice TValue="ExpenseCategory" Label="Category *" Options="Categories" @bind-Value="_category" />
    <div class="form-grid">
        <div class="field"><label for="xa">Amount (@Currency) *</label><input id="xa" class="input" type="number" min="0" step="0.01" inputmode="decimal" @bind="_amount" /></div>
        <div class="field"><label for="xd">Paid on *</label><input id="xd" class="input" type="date" @bind="_spentOn" /></div>
        <div class="field full"><label for="xn">What was it for? *</label><input id="xn" class="input" maxlength="300" placeholder="e.g. November rent" @bind="_description" /></div>
        <div class="field full"><label for="xt">Paid to</label><input id="xt" class="input" maxlength="150" placeholder="Optional, e.g. landlord or shop" @bind="_paidTo" /></div>
    </div>
    <MethodPicker @bind-Method="_method" @bind-Reference="_reference" />
    <div class="form-actions">
        <button class="btn btn-secondary" @onclick="() => _open = false">Cancel</button>
        <button class="btn btn-primary" @onclick="SaveExpense" disabled="@(Busy || _amount is not > 0 || _spentOn is null || string.IsNullOrWhiteSpace(_description))">@(_editId is null ? "Add expense" : "Save expense")</button>
    </div>
</Modal>

<ConfirmDialog @bind-Open="_deleteOpen" Title="@($"Delete {_deleting?.Title}?")" ConfirmText="Delete expense" Busy="Busy" OnConfirm="DeleteExpense">The expense is removed from the totals. The audit log keeps a note of it.</ConfirmDialog>

@if (Me is not null)
{
    <SalaryPaymentDialog Me="Me" @bind-Open="_salaryOpen" Teachers="_teachers" Month="@(_period == "month" ? _from : null)" OnSaved="_ => LoadAll()" />
    <PaymentEditor @ref="_editor" Me="Me" OnChanged="LoadAll" />
}

@code {
    private static readonly IReadOnlyList<Choice<ExpenseCategory>.Option> Categories = Enum.GetValues<ExpenseCategory>().Select(c => new Choice<ExpenseCategory>.Option(c, FinanceLabels.Category(c))).ToList();

    [SupplyParameterFromQuery(Name = "kind")] public string? KindParam { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? FromParam { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? ToParam { get; set; }

    private PaymentEditor? _editor;
    private FinanceSummaryDto? _s;
    private FinanceEntriesDto? _e;
    private ApiException? _error, _entriesError;
    private string _period = "month", _kind = "all", _search = "", _categoryText = "";
    private FinanceSort _sort = FinanceSort.Newest;
    private DateOnly _from = new(DateTime.Today.Year, DateTime.Today.Month, 1), _to;
    private string? _appliedQuery;

    private string PeriodLabel => Periods.Name(_from, _to);
    private string Currency => _s?.CurrencyCode ?? "";
    private ExpenseCategory? CategoryFilter => Enum.TryParse<ExpenseCategory>(_categoryText, out var c) ? c : null;
    private bool Filtered => _kind != "all" || CategoryFilter is not null || !string.IsNullOrWhiteSpace(_search);

    private List<PillTabs<string>.Tab> Tabs => [
        new("all", "All", _e is { } e ? e.IncomeCount + e.SalaryCount + e.ExpenseCount : null),
        new("Income", "Income", _e?.IncomeCount), new("Salary", "Salaries", _e?.SalaryCount), new("Expense", "Expenses", _e?.ExpenseCount)];

    // The page reads its starting view from the link (Salaries, Fees and Reports link here with a period and a type).
    protected override async Task OnParametersSetAsync()
    {
        var query = $"{KindParam}|{FromParam}|{ToParam}";
        if (Me is null || query == _appliedQuery) return;
        _appliedQuery = query;
        ApplyQuery();
        await LoadAll();
    }

    protected override async Task LoadAsync()
    {
        _appliedQuery = $"{KindParam}|{FromParam}|{ToParam}";
        ApplyQuery();
        await LoadAll();
    }

    private void ApplyQuery()
    {
        _kind = KindParam is "Income" or "Salary" or "Expense" ? KindParam : "all";
        _to = _from.AddMonths(1).AddDays(-1);
        if (DateOnly.TryParse(FromParam, out var f) && DateOnly.TryParse(ToParam, out var t) && t >= f)
        {
            (_from, _to) = (f, t);
            _period = Periods.Kind(f, t);
        }
    }

    private async Task LoadAll()
    {
        _s = null;
        (_s, _error) = await Fetch(() => Api.GetAsync<FinanceSummaryDto>($"finance/summary?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}"));
        await LoadEntries(1);
    }

    private string EntriesQuery(int page) =>
        $"from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&sort={_sort}&page={page}&pageSize=25"
        + (_kind == "all" ? "" : $"&kind={_kind}") + (CategoryFilter is { } c ? $"&category={c}" : "")
        + (string.IsNullOrWhiteSpace(_search) ? "" : $"&search={Uri.EscapeDataString(_search.Trim())}");

    private async Task LoadEntries(int page) => (_e, _entriesError) = await Fetch(() => Api.GetAsync<FinanceEntriesDto>($"finance/entries?{EntriesQuery(page)}"));

    private async Task PeriodChanged(PeriodSwitcher.Range r)
    {
        var reload = (r.From, r.To) != (_from, _to);
        (_period, _from, _to) = (r.Period, r.From, r.To);
        if (reload) await LoadAll(); // choosing "Dates" alone changes nothing until "Show"
    }

    private async Task OpenMonth(DateOnly month) { (_period, _from, _to) = ("month", month, month.AddMonths(1).AddDays(-1)); await LoadAll(); }

    private async Task SetKind(string kind)
    {
        _kind = kind;
        if (kind is "Income" or "Salary") _categoryText = "";
        await LoadEntries(1);
    }

    private async Task SetCategory(ExpenseCategory c) { (_kind, _categoryText) = ("Expense", c.ToString()); await LoadEntries(1); }
    private async Task CategoryChanged() { if (CategoryFilter is not null) _kind = "Expense"; await LoadEntries(1); }
    private async Task ClearFilters() { (_kind, _categoryText, _search) = ("all", "", ""); await LoadEntries(1); }

    private Task ExportCsv() => Run(async () => await JS.InvokeVoidAsync("ss.download", $"finance-{_from:yyyy-MM-dd}-to-{_to:yyyy-MM-dd}.csv",
        await Api.GetStringAsync($"finance/entries.csv?{EntriesQuery(1)}"), "text/csv"), "Export ready.");

    private static string KindIcon(FinanceEntryKind k) => k switch { FinanceEntryKind.Income => "trending-up", FinanceEntryKind.Salary => "users", _ => "wallet" };

    // ---- Salaries (shared dialog) ----
    private bool _salaryOpen;
    private List<LookupItem> _teachers = [];
    private async Task OpenSalary()
    {
        if (_teachers.Count == 0)
            _teachers = ((await Fetch(() => Api.GetAsync<PagedResult<TeacherDto>>("teachers?pageSize=100"))).Value?.Items ?? []).Select(t => new LookupItem(t.Id, t.FullName, null)).ToList();
        _salaryOpen = true;
    }

    // ---- Expenses ----
    private bool _open, _deleteOpen;
    private Guid? _editId;
    private ExpenseCategory _category = ExpenseCategory.Rent;
    private decimal? _amount;
    private DateOnly? _spentOn;
    private string? _description, _paidTo, _reference;
    private PaymentMethod _method = PaymentMethod.Cash;
    private FinanceEntryDto? _deleting;
    private string _key = "";

    private void NewExpense()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        (_editId, _category, _amount, _description, _paidTo, _reference, _method) = (null, ExpenseCategory.Rent, null, null, null, null, PaymentMethod.Cash);
        _spentOn = today >= _from && today <= _to ? today : _to < today ? _to : today; // inside the period being viewed when possible
        _key = Guid.NewGuid().ToString("N");
        _open = true;
    }

    private async Task EditExpense(Guid id)
    {
        var (x, err) = await Fetch(() => Api.GetAsync<ExpenseDto>($"finance/expenses/{id}"));
        if (x is null) { if (err is not null) Toasts.Show(err.Describe(), ToastKind.Error); return; }
        (_editId, _category, _amount, _spentOn, _description, _paidTo, _reference, _method) = (x.Id, x.Category, x.Amount, x.SpentOn, x.Description, x.PaidTo, x.Reference, x.Method);
        _open = true;
    }

    private async Task SaveExpense()
    {
        var request = new SaveExpenseRequest(_spentOn ?? DateOnly.FromDateTime(DateTime.Today), _category, _amount ?? 0, _description ?? "", _paidTo, _method, _reference);
        var ok = await Run(async () =>
        {
            if (_editId is { } id) await Api.PutAsync<IdResponse>($"finance/expenses/{id}", request);
            else await Api.PostAsync("finance/expenses", request, _key);
        }, _editId is null ? "Expense added." : "Expense saved.");
        if (ok) { _open = false; await LoadAll(); }
    }

    private void AskDelete(FinanceEntryDto e) => (_deleting, _deleteOpen) = (e, true);

    private async Task DeleteExpense()
    {
        if (_deleting is not { RecordId: var id }) return;
        if (await Run(() => Api.DeleteAsync($"finance/expenses/{id}"), "Expense deleted.")) { _deleteOpen = false; await LoadAll(); }
    }
}
