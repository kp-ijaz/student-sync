@page "/ai/drafts/{Id:guid}"
@attribute [Authorize(Roles = "InstitutionAdmin,Teacher")]
@inherits AppPage
@using System.Text.Json

<DataView Loading="_d is null && _error is null" Error="_error" OnRetry="LoadAsync">
    @if (_d is not null)
    {
        <PageHeader Title="Review AI recap" Subtitle="@_d.SessionTitle">
            <Breadcrumb><a href="/sessions/@_d.SessionId?tab=ai">Back to session</a> /</Breadcrumb>
            <Actions>
                @if (_d.Status == AiDraftStatus.AwaitingTeacherReview)
                {
                    <button class="btn btn-secondary" @onclick="() => _rejectOpen = true">Reject</button>
                    <button class="btn btn-primary" @onclick="Approve" disabled="@Busy"><Icon Name="check" /> Approve</button>
                }
                @if (_d.Status == AiDraftStatus.Approved) { <button class="btn btn-primary" @onclick="Publish" disabled="@Busy">Publish to participants</button> }
            </Actions>
        </PageHeader>
        <div class="row" style="margin:-12px 0 16px"><Badge Style="StatusStyles.For(_d.Status)" /><span class="small muted">Version @_d.CurrentVersion · @(_d.Provider ?? "") @(_d.Model ?? "")</span>
            @if (_d.IsDemo) { <span class="badge slate">Demo content — not generated by an AI model</span> }</div>
        <div class="warn-panel" style="margin-bottom:16px">AI draft — not visible to students until you approve and publish it. Check every fact against what was actually taught; sections marked "suggestion" are AI recommendations, not your instructions.</div>
        @if (_d.RejectionReason is not null) { <div class="error-panel" style="margin-bottom:16px">Rejected: @_d.RejectionReason</div> }

        <div class="grid grid-main">
            <div class="stack">
                <div class="card">
                    <div class="card-head"><h2>Recap</h2>@if (Editable) { <button class="btn btn-secondary btn-sm" @onclick="() => _editing = !_editing">@(_editing ? "Stop editing" : "Edit")</button> }</div>
                    @if (_editing) { <textarea class="textarea" style="min-height:120px" @bind="_recap" aria-label="Recap"></textarea> } else { <p>@_d.Content.Recap</p> }
                    <h3 style="margin-top:12px">Learning outcomes</h3>
                    @if (_editing) { <textarea class="textarea" @bind="_outcomes" aria-label="Learning outcomes, one per line"></textarea><span class="caption">One per line.</span> }
                    else { <ul>@foreach (var o in _d.Content.LearningOutcomes) { <li>@o</li> }</ul> }
                    <h3 style="margin-top:12px">Revision summary</h3>
                    @if (_editing) { <textarea class="textarea" @bind="_revision" aria-label="Revision summary"></textarea> } else { <p>@_d.Content.RevisionSummary</p> }
                    @if (_editing)
                    {
                        <div class="field" style="margin-top:12px"><label for="cn">Change note</label><input id="cn" class="input" @bind="_changeNote" /></div>
                        <div class="form-actions"><button class="btn btn-primary" @onclick="SaveEdits" disabled="@Busy">Save as new version</button></div>
                    }
                </div>
                <div class="card"><h2 style="margin-bottom:8px">Topic notes</h2>
                    @foreach (var t in _d.Content.TopicNotes) { <h3>@t.Topic</h3><p>@t.Notes</p>@foreach (var s in t.Sources ?? []) { <p class="caption">Source @Ts(s.StartSeconds): "@s.Quote"</p> } }
                    @if (_d.Content.TopicNotes.Count == 0) { <p class="muted">None.</p> }</div>
                <div class="card"><h2 style="margin-bottom:8px">Definitions &amp; formulas</h2>
                    <ul>@foreach (var d in _d.Content.Definitions) { <li><strong>@d.Term</strong> — @d.Definition @if (d.Formula is not null) { <code>@d.Formula</code> }</li> }</ul></div>
                <div class="card"><h2 style="margin-bottom:8px">Worked examples</h2>
                    @foreach (var e in _d.Content.Examples) { <h3>@e.Title</h3><ol>@foreach (var s in e.Steps) { <li>@s</li> }</ol> }</div>
                <div class="card"><h2 style="margin-bottom:8px">Questions asked in class</h2>
                    <ul>@foreach (var q in _d.Content.QuestionsAnswered) { <li><strong>Q:</strong> @q.Question<br /><strong>A:</strong> @q.Answer</li> }</ul>
                    <h3>Unanswered questions</h3><ul>@foreach (var q in _d.Content.UnansweredQuestions) { <li>@q</li> }</ul></div>
            </div>
            <div class="stack">
                <div class="card"><h2 style="margin-bottom:8px">Homework mentioned</h2>
                    @foreach (var h in _d.Content.Homework)
                    {
                        <div style="margin-bottom:12px"><strong>@h.Description</strong> <span class="badge @(h.Confidence >= .8 ? "green" : "amber")">@($"{h.Confidence:P0}") confidence</span>
                            <div class="caption">Evidence @Ts(h.Evidence.StartSeconds): "@h.Evidence.Quote"</div>
                            @if (h.StatedDeadline is not null) { <div class="caption">Stated deadline: @h.StatedDeadline</div> }</div>
                    }
                    @if (_d.Content.Homework.Count == 0) { <p class="muted">No homework detected.</p> }</div>
                <div class="card"><h2 style="margin-bottom:8px">Practice questions <span class="badge slate">AI suggestion</span></h2>
                    <ul>@foreach (var p in _d.Content.PracticeQuestions) { <li>@p.Question <div class="caption">Answer: @p.Answer — @p.Explanation</div></li> }</ul></div>
                <div class="card"><h2 style="margin-bottom:8px">Flashcards <span class="badge slate">AI suggestion</span></h2>
                    <ul>@foreach (var f in _d.Content.Flashcards) { <li><strong>@f.Front</strong> — @f.Back</li> }</ul></div>
                <div class="card"><h2 style="margin-bottom:8px">Next class agenda <span class="badge slate">AI suggestion</span></h2>
                    <ul>@foreach (var a in _d.Content.NextClassAgenda) { <li>@a</li> }</ul></div>
                <div class="card"><h2 style="margin-bottom:8px">Version history</h2>
                    <ul class="list">@foreach (var v in _d.Versions) { <li><strong>v@(v.VersionNumber)</strong> <span class="caption">@v.EditedBy · <LocalTime Utc="v.CreatedAtUtc" Tz="@Tz" Format="relative" /> @(v.ChangeNote is null ? "" : $"· {v.ChangeNote}")</span></li> }</ul></div>
            </div>
        </div>
    }
</DataView>

<Modal @bind-Open="_rejectOpen" Title="Reject draft">
    <div class="stack">
        <div class="field"><label for="rr">Reason *</label><textarea id="rr" class="textarea" @bind="_rejectReason"></textarea></div>
        <div class="form-actions"><button class="btn btn-secondary" @onclick="() => _rejectOpen = false">Cancel</button><button class="btn btn-danger" @onclick="Reject" disabled="@(Busy || string.IsNullOrWhiteSpace(_rejectReason))">Reject draft</button></div>
    </div>
</Modal>

@code {
    [Parameter] public Guid Id { get; set; }
    private AiDraftDto? _d;
    private ApiException? _error;
    private bool _editing, _rejectOpen;
    private string _recap = "", _outcomes = "", _revision = "", _rejectReason = "";
    private string? _changeNote;
    private bool Editable => _d?.Status is AiDraftStatus.AwaitingTeacherReview or AiDraftStatus.Approved;

    protected override async Task LoadAsync()
    {
        (_d, _error) = await Fetch(() => Api.GetAsync<AiDraftDto>($"ai/drafts/{Id}"));
        if (_d is not null) (_recap, _outcomes, _revision) = (_d.Content.Recap, string.Join("\n", _d.Content.LearningOutcomes), _d.Content.RevisionSummary);
    }

    private static string Ts(double? s) => s is { } v ? TimeSpan.FromSeconds(v).ToString(@"mm\:ss") : "";

    private async Task SaveEdits()
    {
        var content = _d!.Content with { Recap = _recap, RevisionSummary = _revision, LearningOutcomes = _outcomes.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList() };
        if (await Run(() => Api.PutAsync($"ai/drafts/{Id}", new EditAiDraftRequest(content, _changeNote, _d.RowVersion)), "Saved. Edited drafts need approval again."))
        { _editing = false; await LoadAsync(); }
    }

    private async Task Approve() { if (await Run(() => Api.PostAsync($"ai/drafts/{Id}/approve"), "Draft approved. Publish it to share with participants.")) await LoadAsync(); }
    private async Task Publish() { if (await Run(() => Api.PostAsync($"ai/drafts/{Id}/publish"), "Recap published to participants as a class note.")) await LoadAsync(); }
    private async Task Reject() { if (await Run(() => Api.PostAsync($"ai/drafts/{Id}/reject", new RejectAiDraftRequest(_rejectReason)), "Draft rejected.")) { _rejectOpen = false; await LoadAsync(); } }
}
