@page "/announcements"
@attribute [Authorize]
@inherits AppPage

<PageHeader Title="Announcements">
    <Actions>@if (IsStaff) { <button class="btn btn-primary" @onclick="() => _open = true"><Icon Name="megaphone" /> New announcement</button> }</Actions>
</PageHeader>
<DataView Loading="_items is null && _error is null" Error="_error" OnRetry="LoadAsync" IsEmpty="_items?.Count == 0" EmptyTitle="No announcements" EmptyIcon="megaphone">
    <div class="stack">
        @foreach (var a in _items ?? [])
        {
            <article class="card"><div class="row-between"><h2>@a.Title</h2>
                    <span class="row"><span class="badge slate">@(a.Audience == AnnouncementAudience.Batch ? a.BatchName : a.Audience.ToString())</span>
                        @if (CanManage(a))
                        {
                            <button type="button" class="icon-btn" title="Edit" aria-label="@($"Edit {a.Title}")" @onclick="() => Edit(a)"><Icon Name="pencil" /></button>
                            <button type="button" class="icon-btn" title="Delete" aria-label="@($"Delete {a.Title}")" @onclick="() => (_deleting, _deleteOpen) = (a, true)"><Icon Name="trash" /></button>
                        }</span></div>
                <div class="caption" style="margin-bottom:8px">@a.AuthorName · <LocalTime Utc="a.PublishedAtUtc" Tz="@Tz" /></div>
                <p style="white-space:pre-wrap;margin:0">@a.Body</p></article>
        }
    </div>
</DataView>

<Modal @bind-Open="_open" Title="New announcement">
    <div class="stack">
        <div class="field"><label for="at">Title</label><input id="at" class="input" @bind="_title" /></div>
        <div class="field"><label for="ab">Message</label><textarea id="ab" class="textarea" @bind="_body"></textarea></div>
        <div class="field"><label for="aa">Audience</label>
            <select id="aa" class="select" @bind="_audience">
                @if (IsAdmin) { @foreach (var a in Enum.GetValues<AnnouncementAudience>()) { <option value="@a">@a</option> } }
                else { <option value="@AnnouncementAudience.Batch">A batch I teach</option> }
            </select></div>
        @if (_audience == AnnouncementAudience.Batch) { <div class="field"><label for="ab2">Batch</label><select id="ab2" class="select" @bind="_batchId"><option value="">Choose…</option>@foreach (var b in _batches) { <option value="@b.Id">@b.Name</option> }</select></div> }
        <div class="form-actions"><button class="btn btn-secondary" @onclick="() => _open = false">Cancel</button><button class="btn btn-primary" @onclick="Publish" disabled="@Busy">Publish</button></div>
    </div>
</Modal>

<Modal @bind-Open="_editOpen" Title="Edit announcement">
    <div class="stack">
        <p class="small" style="margin:0">Fixes the text on this page. Notifications already sent keep the old text; the audience stays the same.</p>
        <div class="field"><label for="et">Title</label><input id="et" class="input" maxlength="200" @bind="_title" /></div>
        <div class="field"><label for="eb">Message</label><textarea id="eb" class="textarea" @bind="_body"></textarea></div>
        <div class="form-actions"><button class="btn btn-secondary" @onclick="() => _editOpen = false">Cancel</button><button class="btn btn-primary" @onclick="SaveEdit" disabled="@(Busy || string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_body))">Save</button></div>
    </div>
</Modal>

<ConfirmDialog @bind-Open="_deleteOpen" Title="@($"Delete {_deleting?.Title}?")" ConfirmText="Delete" Busy="Busy" OnConfirm="Delete">It disappears from everyone's announcements. Notifications already sent are not recalled.</ConfirmDialog>

@code {
    private bool _editOpen, _deleteOpen;
    private Guid? _editId;
    private AnnouncementDto? _deleting;
    // The API decides (admin: any, teacher: own); this only hides buttons that would be refused.
    private bool CanManage(AnnouncementDto a) => IsAdmin || (IsStaff && a.AuthorUserId == Me?.Id);
    private void Edit(AnnouncementDto a) => (_editId, _title, _body, _editOpen) = (a.Id, a.Title, a.Body, true);
    private async Task SaveEdit()
    {
        if (_editId is not { } id) return;
        if (await Run(() => Api.PutAsync($"announcements/{id}", new UpdateAnnouncementRequest(_title, _body)), "Announcement saved.")) { _editOpen = false; _title = _body = ""; await LoadAsync(); }
    }
    private async Task Delete()
    {
        if (_deleting is not { } a) return;
        if (await Run(() => Api.DeleteAsync($"announcements/{a.Id}"), "Announcement deleted.")) { _deleteOpen = false; await LoadAsync(); }
    }

    private List<AnnouncementDto>? _items;
    private ApiException? _error;
    private bool _open;
    private string _title = "", _body = "";
    private AnnouncementAudience _audience = AnnouncementAudience.Batch;
    private Guid? _batchId;
    private List<BatchDto> _batches = [];
    protected override async Task LoadAsync()
    {
        if (IsAdmin) _audience = AnnouncementAudience.Everyone;
        (_items, _error) = await Fetch(() => Api.GetAsync<List<AnnouncementDto>>("announcements"));
        if (IsStaff) _batches = (await Fetch(() => Api.GetAsync<List<BatchDto>>("academics/batches"))).Value ?? [];
    }
    private async Task Publish()
    {
        if (await Run(() => Api.PostAsync("announcements", new CreateAnnouncementRequest(_title, _body, _audience, _batchId)), "Announcement published.")) { _open = false; _title = _body = ""; await LoadAsync(); }
    }
}
