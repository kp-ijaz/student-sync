{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "Hangfire": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "" },
  "Jwt": { "Issuer": "StudentSync", "Audience": "StudentSync", "SigningKey": "", "AccessTokenMinutes": 15, "RefreshTokenDays": 30 },
  "Jobs": { "Mode": "Hangfire" },
  "Database": { "MigrateOnStartup": false },
  "Storage": { "Local": { "LocalRootPath": "App_Data/storage" } },
  "Email": { "Smtp": { "Host": "", "Port": 587, "UseStartTls": true, "FromAddress": "no-reply@studentsync.example.test", "FromName": "Student Sync" } },
  "Ai": { "Anthropic": { "ApiKey": "", "Model": "claude-opus-5-5", "InputPricePerMillion": 4.00, "OutputPricePerMillion": 20.00 } },
  "Integrations": { "Google": { "ClientId": "" } },
  "Cors": { "Origins": [] },
  "RateLimits": { "AuthPerMinute": 20 },
  "Demo": { "ForcePasswordChange": true }
}
