@* StateView: empty / error / forbidden / 404 message — an unDraw illustration (Illustrations.*: empty, search, offline,
   server_error, access_denied, not_found, all_done, questions, mailbox), a title, a message and optional actions.
   Compact="true" (tight spaces) shows Icon on two soft discs instead of the illustration. Page="true" for full pages. *@
<div class="state-view @(Compact ? "compact" : "") @(Page ? "page" : "") @Class" role="@Role">
    @if (Compact)
    {
        <span class="state-discs tone-@Tone" aria-hidden="true"><span><Icon Name="@Icon" /></span></span>
    }
    else
    {
        <img class="state-art" src="@Illustrations.Src(Illustration)" alt="" width="200" height="150" />
    }
    @if (Page) { <h1 tabindex="-1">@Title</h1> } else { <h3>@Title</h3> }
    @if (!string.IsNullOrEmpty(Message)) { <p>@Message</p> }
    @if (ChildContent is not null) { <div class="state-actions">@ChildContent</div> }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Message { get; set; }
    [Parameter] public string Illustration { get; set; } = Illustrations.Empty;
    [Parameter] public bool Compact { get; set; }
    /// <summary>Icon for the compact variant.</summary>
    [Parameter] public string Icon { get; set; } = "inbox";
    [Parameter] public string Tone { get; set; } = "blue";
    [Parameter] public bool Page { get; set; }
    /// <summary>"alert" for errors so they are announced; null otherwise.</summary>
    [Parameter] public string? Role { get; set; }
    [Parameter] public string? Class { get; set; }
    /// <summary>Actions (buttons/links) under the message.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
