@page "/admin/arrangements"
@attribute [Authorize(Roles = "InstitutionAdmin")]
@inherits AppPage

<PageHeader Title="Private tuition" Subtitle="One-to-one and private-group arrangements. No batch is involved.">
    <Actions><button class="btn btn-primary" @onclick="New"><Icon Name="plus" /> New arrangement</button></Actions>
</PageHeader>
<div class="card">
    <DataView Loading="_items is null && _error is null" Error="_error" OnRetry="LoadAsync" IsEmpty="_items?.Count == 0" EmptyTitle="No private arrangements" EmptyIcon="user">
        <div class="table-wrap"><table class="table stack-mobile">
            <thead><tr><th>Arrangement</th><th>Type</th><th>Teacher</th><th>Students</th><th>Status</th><th></th></tr></thead>
            <tbody>@foreach (var a in _items ?? [])
            {
                <tr><td data-label="Arrangement"><strong>@a.Title</strong><div class="caption">@(a.SubjectName ?? "") · since @a.StartDate.ToString("d MMM yyyy")</div></td>
                    <td data-label="Type"><Badge Style="StatusStyles.For(a.Type == ArrangementType.OneToOne ? SessionType.OneToOne : SessionType.PrivateGroup)" /></td>
                    <td data-label="Teacher">@a.TeacherName</td><td data-label="Students">@string.Join(", ", a.Students.Select(s => s.Name))</td>
                    <td data-label="Status">@a.Status</td>
                    <td><button class="btn btn-ghost btn-sm" @onclick="() => Edit(a)">Edit</button><a class="btn btn-ghost btn-sm" href="/sessions/new?type=@(a.Type == ArrangementType.OneToOne ? "OneToOne" : "PrivateGroup")">Schedule</a></td></tr>
            }</tbody>
        </table></div>
    </DataView>
</div>
<Modal @bind-Open="_open" Title="@(_id is null ? "New arrangement" : "Edit arrangement")">
    <div class="form-grid">
        <div class="field full"><span class="label">Type</span><div class="segmented" role="group" aria-label="Arrangement type">
            <button aria-pressed="@(Aria.Bool(_type == ArrangementType.OneToOne))" disabled="@(_id is not null)" @onclick="() => { _type = ArrangementType.OneToOne; _students.Clear(); }">One-to-one</button>
            <button aria-pressed="@(Aria.Bool(_type == ArrangementType.PrivateGroup))" disabled="@(_id is not null)" @onclick="() => _type = ArrangementType.PrivateGroup">Private group</button></div></div>
        <div class="field full"><label for="at">Title *</label><input id="at" class="input" @bind="_title" /></div>
        <div class="field"><label for="atr">Teacher *</label><select id="atr" class="select" @bind="_teacher"><option value="">Choose…</option>@foreach (var t in _teachers) { <option value="@t.Id">@t.FullName</option> }</select></div>
        <div class="field"><label for="as">Subject</label><select id="as" class="select" @bind="_subject"><option value="">—</option>@foreach (var s in _subjects) { <option value="@s.Id">@s.Name</option> }</select></div>
        <div class="field full"><span class="label">@(_type == ArrangementType.OneToOne ? "Student (exactly one)" : "Students")</span>
            <div style="max-height:200px;overflow-y:auto;border:1px solid var(--ss-border);border-radius:10px;padding:8px">
                @foreach (var s in _lookup) { <label class="check" style="display:flex;padding:4px"><input type="@(_type == ArrangementType.OneToOne ? "radio" : "checkbox")" name="arr-students" checked="@_students.Contains(s.Id)" @onchange="e => Toggle(s.Id, e.Value)" /> @s.Name</label> }
            </div></div>
        <div class="field full"><label for="an">Notes</label><textarea id="an" class="textarea" @bind="_notes"></textarea></div>
    </div>
    <div class="form-actions"><button class="btn btn-secondary" @onclick="() => _open = false">Cancel</button><button class="btn btn-primary" @onclick="Save" disabled="@Busy">Save</button></div>
</Modal>

@code {
    private List<ArrangementDto>? _items;
    private ApiException? _error;
    private List<TeacherDto> _teachers = [];
    private List<SubjectDto> _subjects = [];
    private List<LookupItem> _lookup = [];
    private readonly HashSet<Guid> _students = [];
    private bool _open;
    private Guid? _id, _teacher, _subject;
    private string _title = "";
    private string? _notes;
    private ArrangementType _type = ArrangementType.OneToOne;

    protected override async Task LoadAsync()
    {
        (_items, _error) = await Fetch(() => Api.GetAsync<List<ArrangementDto>>("academics/arrangements"));
        _teachers = (await Fetch(() => Api.GetAsync<PagedResult<TeacherDto>>("teachers?pageSize=100&status=Active"))).Value?.Items.ToList() ?? [];
        _subjects = (await Fetch(() => Api.GetAsync<List<SubjectDto>>("academics/subjects"))).Value ?? [];
        _lookup = (await Fetch(() => Api.GetAsync<List<LookupItem>>("students/lookup"))).Value ?? [];
    }
    private void Toggle(Guid id, object? v) { if (_type == ArrangementType.OneToOne) _students.Clear(); if (v is true || _type == ArrangementType.OneToOne) _students.Add(id); else _students.Remove(id); }
    private void New() { (_id, _title, _teacher, _subject, _notes, _type) = (null, "", null, null, null, ArrangementType.OneToOne); _students.Clear(); _open = true; }
    private void Edit(ArrangementDto a) { (_id, _title, _teacher, _subject, _notes, _type) = (a.Id, a.Title, a.TeacherId, a.SubjectId, a.Notes, a.Type); _students.Clear(); foreach (var s in a.Students) _students.Add(s.Id); _open = true; }
    private async Task Save()
    {
        if (_teacher is not { } t) { Toasts.Show("Choose a teacher.", ToastKind.Error); return; }
        var req = new SaveArrangementRequest(_type, _title, t, null, _subject, DateOnly.FromDateTime(DateTime.Today), _notes, _students.ToList(), CatalogStatus.Active);
        if (await Run(() => _id is null ? Api.PostAsync("academics/arrangements", req) : Api.PutAsync($"academics/arrangements/{_id}", req), "Arrangement saved.")) { _open = false; await LoadAsync(); }
    }
}
