@if (Open)
{
    <div class="modal-backdrop" @onclick="Close" @onkeydown="OnKey">
        <div class="modal @(Wide ? "wide" : "")" role="dialog" aria-modal="true" aria-labelledby="@_id" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2 id="@_id">@Title</h2>
                <button class="icon-btn" @onclick="Close" aria-label="Close dialog"><Icon Name="x" /></button>
            </div>
            @ChildContent
        </div>
    </div>
}

@code {
    private readonly string _id = "dlg-" + Guid.NewGuid().ToString("N")[..8];
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Wide { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task Close() => OpenChanged.InvokeAsync(false);
    private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
}
