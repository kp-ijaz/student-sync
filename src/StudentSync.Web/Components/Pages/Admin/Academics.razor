@page "/admin/academics"
@attribute [Authorize(Roles = "InstitutionAdmin")]
@inherits AppPage

<PageHeader Title="Academic structure" Subtitle="Syllabi, academic years, classes, courses, subjects and chapters for your institution." />
<div class="tabs" role="tablist">
    @foreach (var (k, l) in new[] { ("courses", "Courses & subjects"), ("curricula", "Syllabi"), ("years", "Academic years"), ("grades", "Classes") })
    { <button role="tab" aria-selected="@(Aria.Bool(_tab == k))" @onclick="() => _tab = k">@l</button> }
</div>
<DataView Loading="_courses is null && _error is null" Error="_error" OnRetry="LoadAsync">
    @if (_tab == "courses")
    {
        @* Owner request 2026-11-17: pick a syllabus, then a class, and see only that class's subjects. *@
        <div class="row-between acad-head"><p class="muted" style="margin:0">Choose a syllabus, then a class, to see and manage its subjects.</p>
            <div class="btn-group"><button class="btn btn-secondary" @onclick="OpenQuickClass">Add a class</button><button class="btn btn-primary" @onclick="NewSubject"><Icon Name="plus" /> Add subject</button></div></div>
        <div class="card acad-picker">
            <span class="bk-label" id="acad-cur">Syllabus</span>
            <div class="pick-group" role="group" aria-labelledby="acad-cur">
                @foreach (var cu in _curricula.Where(c => c.Status == CatalogStatus.Active))
                {
                    <button type="button" class="pick" aria-pressed="@Aria.Bool(!_selOther && _selCur == cu.Id)" @onclick="() => SelectCurriculum(cu.Id)">@cu.Name</button>
                }
                @if (OtherCourses.Count > 0) { <button type="button" class="pick" aria-pressed="@Aria.Bool(_selOther)" @onclick="SelectOther">Other courses</button> }
            </div>
            @if (!_selOther && _selCur is not null)
            {
                <span class="bk-label" id="acad-class">Class</span>
                <div class="pick-group acad-classes" role="group" aria-labelledby="acad-class">
                    @foreach (var g in _grades)
                    {
                        var has = CourseFor(g.Id) is not null;
                        <button type="button" class="pick @(has ? "" : "empty")" aria-pressed="@Aria.Bool(_selGrade == g.Id)" @onclick="() => _selGrade = g.Id"
                                title="@(has ? null : "No subjects yet")">@g.Name</button>
                    }
                </div>
            }
        </div>
        <div class="stack">
            @foreach (var c in ShownCourses)
            {
                <div class="card">
                    <div class="card-head"><div><h2>@c.Name <span class="caption">@c.Code</span></h2><div class="caption">@c.SubjectCount subject@(c.SubjectCount == 1 ? "" : "s")@(c.Status == CatalogStatus.Active ? "" : $" · {c.Status}")</div></div>
                        <div class="btn-group"><button class="btn btn-secondary btn-sm" @onclick="() => EditCourse(c)"><Icon Name="pencil" /> Edit</button>
                            <button class="btn btn-ghost btn-sm danger-text" @onclick='() => Confirm($"Remove {c.Name}?", "The course and its subjects are removed. Only possible when no student, class or work uses them.", () => Api.DeleteAsync($"academics/courses/{c.Id}"), "Course removed.")'><Icon Name="x" /> Remove<span class="sr-only"> @c.Name</span></button></div></div>
                    @if (!_subjects.Any(s => s.CourseId == c.Id)) { <InlineEmpty Icon="book" Text="No subjects yet. Use Add subject." /> }
                    <ul class="acad-subjects">
                        @foreach (var s in _subjects.Where(s => s.CourseId == c.Id).OrderBy(s => s.Name))
                        {
                            <li>
                                <div class="grow"><strong>@s.Name</strong> <span class="caption">@s.Code</span>@if (s.Status != CatalogStatus.Active) { <span class="badge slate">@s.Status</span> }
                                    @if (s.Teachers.Count > 0) { <div class="pill-list" style="margin-top:4px">@foreach (var t in s.Teachers) { <span class="badge removable blue"><span>@t.Name</span><button type="button" class="chip-remove" aria-label="Unassign @t.Name" title="Unassign" @onclick="() => Unassign(s, t.Id)"><Icon Name="x" /></button></span> }</div> }
                                    @if (s.Chapters.Count > 0)
                                    {
                                        <ul class="small acad-chapters">@foreach (var ch in s.Chapters)
                                        {
                                            <li><span class="acad-chapter-title">@ch.Title</span>
                                                <button type="button" class="icon-btn icon-btn-sm" title="Rename chapter" aria-label="@($"Rename chapter {ch.Title}")" @onclick="() => RenameChapter(ch)"><Icon Name="pencil" /></button>
                                                <button type="button" class="icon-btn icon-btn-sm" title="Remove chapter" aria-label="@($"Remove chapter {ch.Title}")" @onclick='() => Confirm($"Remove chapter {ch.Title}?", "Its topics are removed too. Only possible when no class, question, material or doubt uses it.", () => Api.DeleteAsync($"academics/chapters/{ch.Id}"), "Chapter removed.")'><Icon Name="trash" /></button>
                                                @if (ch.Topics.Count > 0)
                                                {
                                                    <span class="pill-list acad-topics">@foreach (var t in ch.Topics)
                                                    {
                                                        <span class="badge removable slate"><button type="button" class="chip-text" title="Rename topic" aria-label="@($"Rename topic {t.Title}")" @onclick="() => RenameTopic(t)">@t.Title</button><button type="button" class="chip-remove" aria-label="@($"Remove topic {t.Title}")" title="Remove topic" @onclick='() => Confirm($"Remove topic {t.Title}?", "The topic is removed from this chapter.", () => Api.DeleteAsync($"academics/topics/{t.Id}"), "Topic removed.")'><Icon Name="x" /></button></span>
                                                    }</span>
                                                }
                                                <button class="btn btn-ghost btn-sm" @onclick="() => OpenTopic(ch)">+ topic</button></li>
                                        }</ul>
                                    }
                                </div>
                                <div class="btn-group acad-subject-actions">
                                    <button class="btn btn-ghost btn-sm" @onclick="() => EditSubject(s)">Edit<span class="sr-only"> @s.Name</span></button>
                                    <button class="btn btn-ghost btn-sm" @onclick="() => OpenAssign(s)">Teacher<span class="sr-only"> for @s.Name</span></button>
                                    <button class="btn btn-ghost btn-sm" @onclick="() => OpenChapter(s)">Chapter<span class="sr-only"> for @s.Name</span></button>
                                    <button class="btn btn-ghost btn-sm danger-text" @onclick='() => Confirm($"Remove {s.Name}?", "Only possible when no student, class or work uses this subject.", () => Api.DeleteAsync($"academics/subjects/{s.Id}"), "Subject removed.")'>Remove<span class="sr-only"> @s.Name</span></button>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
            @if (!_selOther && _selGrade is { } sg && SelectedCourse is null)
            {
                <div class="card"><InlineEmpty Icon="book" Text="@($"No subjects for {_grades.FirstOrDefault(g => g.Id == sg)?.Name} · {_curricula.FirstOrDefault(c => c.Id == _selCur)?.Name} yet.")" />
                    <div class="form-actions" style="margin-top:8px"><button class="btn btn-primary" @onclick="NewSubject"><Icon Name="plus" /> Add subject</button></div></div>
            }
        </div>
        <details class="card catalogue-defaults">
            <summary><strong>Standard syllabi and classes</strong> <span class="caption">NCERT, Kerala State, ICSE · Classes 1–12</span></summary>
            <p class="caption">A ready-made list: the three syllabi, Classes 1–12 and each class's usual subjects, plus the current academic year. It is already loaded for you. Running it again only adds anything missing and tidies names (for example “+1” becomes “Class 11”); nothing is removed.</p>
            <button class="btn btn-secondary btn-sm" @onclick="LoadDefaults" disabled="@Busy"><Icon Name="refresh" /> Check the standard list</button>
        </details>
    }
    @if (_tab == "curricula")
    {
        <div class="row-between" style="margin-bottom:16px"><p class="muted" style="margin:0">The boards or syllabi your students follow, for example NCERT or Kerala State. Each student's profile records theirs.</p>
            <button class="btn btn-primary" @onclick="NewCurriculum"><Icon Name="plus" /> Add syllabus</button></div>
        <div class="card">
            @if (_curricula.Count == 0) { <InlineEmpty Icon="book" Text="No syllabi yet. Add NCERT, Kerala State or any other board you teach." /> }
            else
            {
                <ul class="list">@foreach (var c in _curricula)
                {
                    <li class="row-between"><div><strong>@c.Name</strong> <span class="caption">@c.Code · @c.StudentCount student@(c.StudentCount == 1 ? "" : "s")</span> @if (c.Status != CatalogStatus.Active) { <span class="badge slate">@c.Status</span> }</div>
                        <span class="btn-group"><button class="btn btn-ghost btn-sm" @onclick="() => EditCurriculum(c)">Edit<span class="sr-only"> @c.Name</span></button>
                            <button class="btn btn-ghost btn-sm danger-text" @onclick='() => Confirm($"Remove {c.Name}?", "Only possible when no student, course or exam uses this syllabus.", () => Api.DeleteAsync($"academics/curricula/{c.Id}"), "Syllabus removed.")'>Remove<span class="sr-only"> @c.Name</span></button></span></li>
                }</ul>
            }
        </div>
    }
    @if (_tab == "years")
    {
        <div class="row-between" style="margin-bottom:16px"><span></span><button class="btn btn-primary" @onclick="NewYear"><Icon Name="plus" /> Add academic year</button></div>
        <div class="stack">@foreach (var y in _years) { <div class="card"><div class="row-between"><div><h2>@y.Name @if (y.IsCurrent) { <span class="badge green">Current</span> }</h2><div class="caption">@y.StartDate.ToString("d MMM yyyy") – @y.EndDate.ToString("d MMM yyyy")</div></div><div class="btn-group"><button class="btn btn-secondary btn-sm" @onclick="() => OpenTerm(y)">Add term</button><button class="btn btn-ghost btn-sm" @onclick="() => EditYear(y)">Edit<span class="sr-only"> @y.Name</span></button>
                <button class="btn btn-ghost btn-sm danger-text" @onclick='() => Confirm($"Remove {y.Name}?", "Only possible when no student or course uses this year.", () => Api.DeleteAsync($"academics/years/{y.Id}"), "Academic year removed.")'>Remove<span class="sr-only"> @y.Name</span></button></div></div>
            <ul class="acad-terms">@foreach (var t in y.Terms)
            {
                <li><span>@t.Name: @t.StartDate.ToString("d MMM") – @t.EndDate.ToString("d MMM yyyy")</span>
                    <button type="button" class="icon-btn icon-btn-sm" title="Edit term" aria-label="@($"Edit term {t.Name}")" @onclick="() => EditTerm(y, t)"><Icon Name="pencil" /></button>
                    <button type="button" class="icon-btn icon-btn-sm" title="Remove term" aria-label="@($"Remove term {t.Name}")" @onclick='() => Confirm($"Remove term {t.Name}?", "The term is removed from this academic year.", () => Api.DeleteAsync($"academics/terms/{t.Id}"), "Term removed.")'><Icon Name="trash" /></button></li>
            }</ul></div> }</div>
    }
    @if (_tab == "grades")
    {
        <div class="card">
            <div class="row grade-add"><label for="gname" class="sr-only">New class name</label><input id="gname" class="input grow" placeholder="New class, e.g. Class 11 or LKG" @bind="_gradeName" @bind:event="oninput" />
                <button class="btn btn-primary" @onclick="AddGrade" disabled="@(Busy || string.IsNullOrWhiteSpace(_gradeName))"><Icon Name="plus" /> Add class</button></div>
            <p class="caption">Classes are listed in order (Class 1 … Class 12, then any others). Editing a name keeps every student and course in it.</p>
            <ul class="list">@foreach (var g in _grades)
            {
                <li class="row-between"><span><strong>@g.Name</strong></span>
                    <span class="btn-group"><button class="btn btn-ghost btn-sm" @onclick="() => EditGrade(g)">Edit<span class="sr-only"> @g.Name</span></button>
                        <button class="btn btn-ghost btn-sm danger-text" @onclick='() => Confirm($"Remove {g.Name}?", "Only possible when no student, course or exam is in this class.", () => Api.DeleteAsync($"academics/grades/{g.Id}"), "Class removed.")'>Remove<span class="sr-only"> @g.Name</span></button></span></li>
            }</ul></div>
    }
</DataView>

<Modal @bind-Open="_curriculumOpen" Title="@(_curriculumId is null ? "Add syllabus" : "Edit syllabus")">
    @if (_curriculumId is null) { <p class="caption">The code is assigned automatically.</p> }
    <div class="form-grid">
        @if (_curriculumId is not null) { <div class="field"><span class="label">Code</span><span class="code-ro">@_cuCode</span></div> }
        <div class="field"><label for="cun">Name *</label><input id="cun" class="input" maxlength="100" placeholder="e.g. Kerala State (SCERT)" @bind="_cuName" /></div>
        <div class="field"><label for="cus">Status</label><select id="cus" class="select" @bind="_cuStatus">@foreach (var s in Enum.GetValues<CatalogStatus>()) { <option value="@s">@s</option> }</select></div>
    </div>
    <div class="form-actions"><button class="btn btn-secondary" @onclick="() => _curriculumOpen = false">Cancel</button><button class="btn btn-primary" @onclick="SaveCurriculum" disabled="@Busy">Save</button></div>
</Modal>
<Modal @bind-Open="_courseOpen" Title="@(_courseId is null ? "Add course" : "Edit course")">
    @if (_courseId is null) { <p class="caption">The code is assigned automatically (for example NCERT-C5).</p> }
    <div class="form-grid">
        @if (_courseId is not null) { <div class="field"><span class="label">Code</span><span class="code-ro">@_cCode</span></div> }
        <div class="field"><label for="cn">Name *</label><input id="cn" class="input" @bind="_cName" /></div>
        <div class="field"><label for="cg">Grade</label><select id="cg" class="select" @bind="_cGrade"><option value="">—</option>@foreach (var g in _grades) { <option value="@g.Id">@g.Name</option> }</select></div>
        <div class="field"><label for="ccu">Syllabus</label><select id="ccu" class="select" @bind="_cCur"><option value="">—</option>@foreach (var cu in _curricula) { <option value="@cu.Id">@cu.Name</option> }</select></div>
        <div class="field"><label for="cy">Academic year</label><select id="cy" class="select" @bind="_cYear"><option value="">—</option>@foreach (var y in _years) { <option value="@y.Id">@y.Name</option> }</select></div>
        <div class="field"><label for="cs">Status</label><select id="cs" class="select" @bind="_cStatus">@foreach (var s in Enum.GetValues<CatalogStatus>()) { <option value="@s">@s</option> }</select></div>
        <div class="field full"><label for="cd">Description</label><textarea id="cd" class="textarea" @bind="_cDesc"></textarea></div>
    </div>
    <div class="form-actions"><button class="btn btn-secondary" @onclick="() => _courseOpen = false">Cancel</button><button class="btn btn-primary" @onclick="SaveCourse" disabled="@Busy">Save</button></div>
</Modal>
<Modal @bind-Open="_subjectOpen" Title="@(_subjectId is null ? "Add subject" : "Edit subject")">
    @if (_subjectId is null)
    {
        <div class="form-grid">
            <div class="field"><label for="ns-cur">Syllabus *</label><select id="ns-cur" class="select" @bind="_nsCur"><option value="">Choose the syllabus</option>@foreach (var cu in _curricula.Where(c => c.Status == CatalogStatus.Active)) { <option value="@cu.Id">@cu.Name</option> }</select></div>
            <div class="field"><label for="ns-grade">Class *</label><select id="ns-grade" class="select" @bind="_nsGrade" disabled="@(_nsCur is null)"><option value="">Choose the class</option>@foreach (var g in _grades) { <option value="@g.Id">@g.Name</option> }</select></div>
            <div class="field full"><label for="sna">Subject name *</label><input id="sna" class="input" maxlength="100" placeholder="e.g. Accountancy" @bind="_sName" @bind:event="oninput" /></div>
        </div>
        <p class="caption">The code is assigned automatically. If the class has no subjects yet, it is set up too.</p>
    }
    else
    {
        <div class="form-grid">
            <div class="field full"><label for="sna">Name *</label><input id="sna" class="input" maxlength="150" @bind="_sName" @bind:event="oninput" /></div>
            <div class="field"><span class="label">Class</span><span class="code-ro">@(_courses?.FirstOrDefault(c => c.Id == _sCourse)?.Name ?? "—")</span></div>
            <div class="field"><span class="label">Code</span><span class="code-ro">@_sCode</span></div>
            <div class="field"><label for="sst2">Status</label><select id="sst2" class="select" @bind="_sStatus">@foreach (var st in Enum.GetValues<CatalogStatus>()) { <option value="@st">@st</option> }</select>
                <span class="help">Archived subjects are hidden from new choices but kept on record.</span></div>
        </div>
    }
    <div class="form-actions"><button class="btn btn-secondary" @onclick="() => _subjectOpen = false">Cancel</button>
        <button class="btn btn-primary" @onclick="SaveSubject" disabled="@(Busy || string.IsNullOrWhiteSpace(_sName) || (_subjectId is null && (_nsCur is null || _nsGrade is null)))">@(_subjectId is null ? "Add subject" : "Save")</button></div>
</Modal>
<Modal Open="_chapterFor is not null" OpenChanged="_ => _chapterFor = null" Title="@($"Add chapter to {_chapterFor?.Name}")">
    <div class="stack"><div class="field"><label for="cht">Title</label><input id="cht" class="input" @bind="_text" /></div>
        <div class="form-actions"><button class="btn btn-primary" @onclick="SaveChapter" disabled="@Busy">Add</button></div></div>
</Modal>
<Modal Open="_topicFor is not null" OpenChanged="_ => _topicFor = null" Title="@($"Add topic to {_topicFor?.Title}")">
    <div class="stack"><div class="field"><label for="tpt">Title</label><input id="tpt" class="input" @bind="_text" /></div>
        <div class="form-actions"><button class="btn btn-primary" @onclick="SaveTopic" disabled="@Busy">Add</button></div></div>
</Modal>
<Modal Open="_assignFor is not null" OpenChanged="_ => _assignFor = null" Title="@($"Assign a teacher to {_assignFor?.Name}")">
    <div class="stack"><div class="field"><label for="at">Teacher</label><select id="at" class="select" @bind="_teacherId"><option value="">Choose…</option>@foreach (var t in _teachers) { <option value="@t.Id">@t.FullName</option> }</select></div>
        <div class="form-actions"><button class="btn btn-primary" @onclick="Assign" disabled="@(Busy || _teacherId is null)">Assign</button></div></div>
</Modal>
<Modal Open="_enrolFor is not null" OpenChanged="_ => _enrolFor = null" Title="@($"Enrolments — {_enrolFor?.Name}")" Wide="true">
    <div class="stack">
        <div class="row"><select class="select grow" @bind="_enrolStudent" aria-label="Student to enrol"><option value="">Enrol a student…</option>@foreach (var s in _lookup.Where(l => _enrolments.All(e => e.StudentId != l.Id || e.Status != EnrolmentStatus.Active))) { <option value="@s.Id">@s.Name (@s.Detail)</option> }</select>
            <button class="btn btn-primary" @onclick="Enrol" disabled="@(Busy || _enrolStudent is null)">Enrol</button></div>
        <div class="table-wrap"><table class="table stack-mobile"><thead><tr><th>Student</th><th>Status</th><th>Since</th><th></th></tr></thead>
            <tbody>@foreach (var e in _enrolments) { <tr><td data-label="Student">@e.StudentName</td><td data-label="Status">@e.Status</td><td data-label="Since" class="small">@Time.Date(e.EnrolledAtUtc, Tz)</td><td>@if (e.Status == EnrolmentStatus.Active) { <button class="btn btn-ghost btn-sm" @onclick="() => Withdraw(e)">Withdraw</button> }</td></tr> }</tbody></table></div>
    </div>
</Modal>
<Modal @bind-Open="_yearOpen" Title="@(_yearId is null ? "Add academic year" : "Edit academic year")">
    <div class="form-grid">
        <div class="field full"><label for="yn">Name</label><input id="yn" class="input" placeholder="2026–27" @bind="_yearName" /></div>
        <div class="field"><label for="ys">Starts</label><input id="ys" type="date" class="input" @bind="_yStart" /></div>
        <div class="field"><label for="ye">Ends</label><input id="ye" type="date" class="input" @bind="_yEnd" /></div>
        <div class="field full"><label class="check"><input type="checkbox" @bind="_yCurrent" /> Current year</label></div>
    </div>
    <div class="form-actions"><button class="btn btn-primary" @onclick="SaveYear" disabled="@Busy">Save</button></div>
</Modal>
<Modal Open="_rename is not null" OpenChanged="_ => _rename = null" Title="@(_rename?.Title ?? "")">
    <div class="stack"><div class="field"><label for="rnm">Name</label><input id="rnm" class="input" maxlength="200" @bind="_text" /></div>
        <div class="form-actions"><button class="btn btn-secondary" @onclick="() => _rename = null">Cancel</button><button class="btn btn-primary" @onclick="SaveRename" disabled="@(Busy || string.IsNullOrWhiteSpace(_text))">Save</button></div></div>
</Modal>
<Modal Open="_termFor is not null" OpenChanged="_ => (_termFor, _termId) = (null, null)" Title="@(_termId is null ? $"Add term to {_termFor?.Name}" : "Edit term")">
    <div class="form-grid">
        <div class="field full"><label for="tn2">Name</label><input id="tn2" class="input" @bind="_text" /></div>
        <div class="field"><label for="ts2">Starts</label><input id="ts2" type="date" class="input" @bind="_yStart" /></div>
        <div class="field"><label for="te2">Ends</label><input id="te2" type="date" class="input" @bind="_yEnd" /></div>
    </div>
    <div class="form-actions"><button class="btn btn-primary" @onclick="SaveTerm" disabled="@Busy">@(_termId is null ? "Add term" : "Save term")</button></div>
</Modal>

<Modal Open="_confirm is not null" OpenChanged="_ => _confirm = null" Title="@(_confirm?.Title ?? "")">
    @if (_confirm is { } cf)
    {
        <p>@cf.Text</p>
        <div class="form-actions"><button class="btn btn-secondary" @onclick="() => _confirm = null">Keep it</button>
            <button class="btn btn-danger" @onclick="RunConfirm" disabled="@Busy">Remove</button></div>
    }
</Modal>
<Modal Open="_gradeEdit is not null" OpenChanged="_ => _gradeEdit = null" Title="Edit class">
    <div class="form-grid">
        <div class="field"><label for="ge-n">Name *</label><input id="ge-n" class="input" @bind="_geName" /></div>
        <div class="field"><label for="ge-o">Order</label><input id="ge-o" type="number" min="1" max="99" class="input" @bind="_geOrder" />
            <span class="help">Where it appears in lists (Class 5 = 5).</span></div>
    </div>
    <div class="form-actions"><button class="btn btn-secondary" @onclick="() => _gradeEdit = null">Cancel</button>
        <button class="btn btn-primary" @onclick="SaveGrade" disabled="@(Busy || string.IsNullOrWhiteSpace(_geName))">Save</button></div>
</Modal>

@* "Add a class": class + syllabus → the usual subjects ticked → one save (POST /academics/catalogue/classes). *@
<Modal @bind-Open="_qcOpen" Title="Add a class">
    <div class="form-grid">
        <div class="field"><label for="qcg">Class *</label><select id="qcg" class="select" @bind="_qcGrade" @bind:after="Suggest"><option value="">Choose the class</option>@foreach (var g in _grades) { <option value="@g.Id">@g.Name</option> }</select></div>
        <div class="field"><label for="qcc">Syllabus *</label><select id="qcc" class="select" @bind="_qcCur" @bind:after="Suggest"><option value="">Choose the syllabus</option>@foreach (var cu in _curricula.Where(c => c.Status == CatalogStatus.Active)) { <option value="@cu.Id">@cu.Name</option> }</select></div>
    </div>
    @if (_qc is { } q)
    {
        <fieldset class="field">
            <legend>Subjects in @q.CourseName</legend>
            @if (q.CourseId is not null) { <span class="help">This class already exists. Ticked subjects it does not have yet are added.</span> }
            <div class="pick-group multi" role="group" aria-label="Subjects">
                @foreach (var name in q.Existing) { <button type="button" class="pick" aria-pressed="true" disabled title="Already in this class">@name</button> }
                @foreach (var name in _qcNames.Where(n => !q.Existing.Contains(n, StringComparer.OrdinalIgnoreCase)))
                { <button type="button" class="pick" aria-pressed="@Aria.Bool(_qcChosen.Contains(name))" @onclick="() => ToggleQc(name)">@name</button> }
            </div>
            <div class="row" style="flex-wrap:nowrap;margin-top:8px">
                <label for="qcn" class="sr-only">Another subject</label>
                <input id="qcn" class="input grow" placeholder="Another subject, e.g. Accountancy" @bind="_qcNew" @bind:event="oninput" @onkeydown="QcKey" />
                <button type="button" class="btn btn-secondary" @onclick="AddQcName" disabled="@string.IsNullOrWhiteSpace(_qcNew)">Add</button>
            </div>
        </fieldset>
    }
    else if (_qcGrade is not null && _qcCur is not null) { <div class="sk sk-line w60" aria-hidden="true"></div> }
    else { <p class="help">Choose the class and the syllabus; their usual subjects appear ticked.</p> }
    <div class="form-actions">
        <button class="btn btn-ghost" style="margin-right:auto" @onclick="() => { _qcOpen = false; NewCourse(); }">Other kind of course…</button>
        <button class="btn btn-secondary" @onclick="() => _qcOpen = false">Cancel</button>
        <button class="btn btn-primary" @onclick="SaveQuickClass" disabled="@(Busy || _qc is null || _qcChosen.Count == 0)">@(_qc is null ? "Save" : _qcChosen.Count == 0 ? "Nothing new to add" : _qc.CourseId is null ? $"Create with {Subjects(_qcChosen.Count)}" : $"Add {Subjects(_qcChosen.Count)}")</button>
    </div>
</Modal>

@code {
    private string _tab = "courses";
    private List<CourseDto>? _courses;
    private ApiException? _error;
    private List<SubjectDto> _subjects = [];
    private List<GradeLevelDto> _grades = [];
    private List<CurriculumDto> _curricula = [];
    private List<AcademicYearDto> _years = [];
    private List<TeacherDto> _teachers = [];
    private List<LookupItem> _lookup = [];
    private List<CourseEnrolmentDto> _enrolments = [];
    private bool _courseOpen, _subjectOpen, _yearOpen, _yCurrent, _curriculumOpen;
    private Guid? _curriculumId;
    private string _cuCode = "", _cuName = "";
    private CatalogStatus _cuStatus = CatalogStatus.Active;
    private Guid? _courseId, _cGrade, _cYear, _cCur, _sCourse, _teacherId, _enrolStudent, _subjectId;
    private bool _qcOpen;
    private Guid? _qcGrade, _qcCur;
    private QuickClassSuggestionDto? _qc;
    private List<string> _qcNames = [];
    private readonly HashSet<string> _qcChosen = new(StringComparer.OrdinalIgnoreCase);
    private string? _qcNew;

    private void OpenQuickClass() { (_qcGrade, _qcCur, _qc, _qcNew) = (null, null, null, null); _qcNames = []; _qcChosen.Clear(); _qcOpen = true; }

    private async Task Suggest()
    {
        _qc = null;
        if (_qcGrade is not { } g || _qcCur is not { } c) return;
        _qc = (await Fetch(() => Api.GetAsync<QuickClassSuggestionDto>($"academics/catalogue/suggest?gradeLevelId={g}&curriculumId={c}"))).Value;
        _qcNames = _qc?.Suggested.ToList() ?? [];
        _qcChosen.Clear();
        foreach (var n in _qcNames.Where(n => !(_qc?.Existing.Contains(n, StringComparer.OrdinalIgnoreCase) ?? false))) _qcChosen.Add(n);
    }

    private static string Subjects(int n) => n == 1 ? "1 subject" : $"{n} subjects";

    private void ToggleQc(string name) { if (!_qcChosen.Remove(name)) _qcChosen.Add(name); }

    private void AddQcName()
    {
        var name = _qcNew?.Trim();
        if (string.IsNullOrEmpty(name)) return;
        // Already in this class: it shows as a fixed chip, nothing to add.
        if (_qc?.Existing.Contains(name, StringComparer.OrdinalIgnoreCase) != true)
        {
            if (!_qcNames.Contains(name, StringComparer.OrdinalIgnoreCase)) _qcNames.Add(name);
            _qcChosen.Add(name);
        }
        _qcNew = null;
    }

    private void QcKey(KeyboardEventArgs e) { if (e.Key == "Enter") AddQcName(); }

    private async Task SaveQuickClass()
    {
        if (_qcGrade is not { } g || _qcCur is not { } c) return;
        var name = _qc?.CourseName;
        if (await Run(() => Api.PostAsync<IdResponse>("academics/catalogue/classes", new QuickClassRequest(g, c, _qcChosen.ToList())), $"{name} saved with its subjects."))
        { _qcOpen = false; await LoadAsync(); }
    }
    private SubjectKind _sKind = SubjectKind.Core;
    private CatalogStatus _sStatus = CatalogStatus.Active;
    private string? _sGroup, _sDesc;
    private string _cCode = "", _cName = "", _sCode = "", _sName = "", _text = "", _gradeName = "", _yearName = "";
    private string? _cDesc;
    private CatalogStatus _cStatus = CatalogStatus.Active;
    private SubjectDto? _chapterFor, _assignFor;
    private ChapterDto? _topicFor;
    private CourseDto? _enrolFor;
    private AcademicYearDto? _termFor;
    private DateOnly _yStart = DateOnly.FromDateTime(DateTime.Today), _yEnd = DateOnly.FromDateTime(DateTime.Today.AddMonths(10));

    protected override async Task LoadAsync()
    {
        try
        {
            _courses = await Api.GetAsync<List<CourseDto>>("academics/courses");
            _subjects = await Api.GetAsync<List<SubjectDto>>("academics/subjects");
            _grades = await Api.GetAsync<List<GradeLevelDto>>("academics/grades");
            _curricula = await Api.GetAsync<List<CurriculumDto>>("academics/curricula");
            _years = await Api.GetAsync<List<AcademicYearDto>>("academics/years");
            DefaultSelection();
        }
        catch (ApiException ex) { _error = ex; }
    }

    private void NewCurriculum() { (_curriculumId, _cuCode, _cuName, _cuStatus) = (null, "", "", CatalogStatus.Active); _curriculumOpen = true; }
    private void EditCurriculum(CurriculumDto c) { (_curriculumId, _cuCode, _cuName, _cuStatus) = (c.Id, c.Code, c.Name, c.Status); _curriculumOpen = true; }
    private async Task SaveCurriculum()
    {
        var req = new SaveCurriculumRequest(_cuCode, _cuName, _cuStatus);
        if (await Run(() => _curriculumId is null ? Api.PostAsync("academics/curricula", req) : Api.PutAsync($"academics/curricula/{_curriculumId}", req), "Syllabus saved.")) { _curriculumOpen = false; await LoadAsync(); }
    }
    private void NewCourse() { (_courseId, _cCode, _cName, _cGrade, _cYear, _cDesc, _cStatus, _cCur) = (null, "", "", null, null, null, CatalogStatus.Active, null); _courseOpen = true; }
    private void EditCourse(CourseDto c) { (_courseId, _cCode, _cName, _cGrade, _cDesc, _cStatus, _cCur) = (c.Id, c.Code, c.Name, c.GradeLevelId, c.Description, c.Status, c.CurriculumId); _courseOpen = true; }

    private async Task LoadDefaults()
    {
        DefaultCatalogueResult? r = null;
        if (await Run(async () => r = await Api.PostAsync<DefaultCatalogueResult>("academics/catalogue/defaults", null)) && r is not null)
        {
            Toasts.Show(r.Courses + r.Subjects + r.Syllabi + r.Classes + r.AcademicYears + r.Tidied == 0
                ? "The default catalogue is already loaded; nothing was missing."
                : $"Added {r.Syllabi} syllabi, {r.Classes} classes, {r.Courses} class courses, {r.Subjects} subjects and {r.AcademicYears} academic year; tidied {r.Tidied} name(s).");
            await LoadAsync();
        }
    }
    private async Task SaveCourse()
    {
        var req = new SaveCourseRequest(_cCode, _cName, _cDesc, _cGrade, _cYear, _cStatus, _cCur);
        if (await Run(() => _courseId is null ? Api.PostAsync("academics/courses", req) : Api.PutAsync($"academics/courses/{_courseId}", req), "Course saved.")) { _courseOpen = false; await LoadAsync(); }
    }
    private void NewSubject() { (_subjectId, _sName, _nsCur, _nsGrade) = (null, "", _selOther ? null : _selCur, _selOther ? null : _selGrade); _subjectOpen = true; }
    private void EditSubject(SubjectDto s) { (_subjectId, _sCourse, _sCode, _sName, _sDesc, _sStatus, _sKind, _sGroup) = (s.Id, s.CourseId, s.Code, s.Name, s.Description, s.Status, s.Kind, s.ChoiceGroup); _subjectOpen = true; }

    // ---- Syllabus → class → subjects ----
    private Guid? _selCur, _selGrade, _nsCur, _nsGrade;
    private string? _shownChip; // tab + class last scrolled into view
    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var key = $"{_tab}:{_selGrade}";
        if (key == _shownChip) return;
        _shownChip = key;
        if (_tab != "courses" || _selGrade is null) return;
        try { await JS.InvokeVoidAsync("ss.chipIntoView", ".acad-classes"); } catch (JSException) { }
    }
    private bool _selOther;
    private CourseDto? CourseFor(Guid gradeId) => _courses?.FirstOrDefault(c => c.GradeLevelId == gradeId && c.CurriculumId == _selCur && c.Status != CatalogStatus.Archived);
    private CourseDto? SelectedCourse => _selGrade is { } g ? CourseFor(g) : null;
    private List<CourseDto> OtherCourses => (_courses ?? []).Where(c => c.CurriculumId is null || c.GradeLevelId is null).ToList();
    private IEnumerable<CourseDto> ShownCourses => _selOther ? OtherCourses : SelectedCourse is { } c ? [c] : [];
    private void SelectCurriculum(Guid id) { (_selCur, _selOther) = (id, false); if (_selGrade is not { } g || CourseFor(g) is null) _selGrade = _grades.FirstOrDefault(x => CourseFor(x.Id) is not null)?.Id ?? _selGrade; }
    private void SelectOther() => _selOther = true;
    /// <summary>First visit: the first syllabus that has classes, and its first class.</summary>
    private void DefaultSelection()
    {
        if (_selCur is not null || _selOther) return;
        var first = _curricula.Where(c => c.Status == CatalogStatus.Active).FirstOrDefault(cu => (_courses ?? []).Any(c => c.CurriculumId == cu.Id));
        if (first is not null) SelectCurriculum(first.Id); else if (OtherCourses.Count > 0) _selOther = true;
    }
    private async Task SaveSubject()
    {
        var name = _sName.Trim();
        if (_subjectId is null)
        {
            if (_nsCur is not { } cu || _nsGrade is not { } g) return;
            if (await Run(() => Api.PostAsync<IdResponse>("academics/catalogue/classes", new QuickClassRequest(g, cu, [name])), $"“{name}” added."))
            { _subjectOpen = false; await LoadAsync(); (_selOther, _selCur, _selGrade) = (false, cu, g); }
            return;
        }
        // Kind and choice group are no longer shown (owner request 2026-11-17); existing values are kept.
        var req = new SaveSubjectRequest(_sCourse!.Value, _sCode, name, _sDesc, _sStatus, _sKind, _sKind == SubjectKind.Core ? null : _sGroup);
        if (await Run(() => Api.PutAsync($"academics/subjects/{_subjectId}", req), "Subject saved.")) { _subjectOpen = false; await LoadAsync(); }
    }
    private void OpenChapter(SubjectDto s) { _chapterFor = s; _text = ""; }
    private async Task SaveChapter() { if (await Run(() => Api.PostAsync($"academics/subjects/{_chapterFor!.Id}/chapters", new SaveChapterRequest(_text, _chapterFor.Chapters.Count + 1)), "Chapter added.")) { _chapterFor = null; await LoadAsync(); } }
    private void OpenTopic(ChapterDto c) { _topicFor = c; _text = ""; }
    private async Task SaveTopic() { if (await Run(() => Api.PostAsync($"academics/chapters/{_topicFor!.Id}/topics", new SaveTopicRequest(_text, _topicFor.Topics.Count + 1)), "Topic added.")) { _topicFor = null; await LoadAsync(); } }
    private async Task OpenAssign(SubjectDto s) { _assignFor = s; _teacherId = null; _teachers = (await Fetch(() => Api.GetAsync<PagedResult<TeacherDto>>("teachers?pageSize=100&status=Active"))).Value?.Items.ToList() ?? []; }
    private async Task Assign() { if (await Run(() => Api.PostAsync($"academics/subjects/{_assignFor!.Id}/teachers", new AssignTeacherRequest(_teacherId!.Value)), "Teacher assigned.")) { _assignFor = null; await LoadAsync(); } }
    private async Task Unassign(SubjectDto s, Guid t) { if (await Run(() => Api.DeleteAsync($"academics/subjects/{s.Id}/teachers/{t}"), "Teacher unassigned.")) await LoadAsync(); }
    private async Task OpenEnrol(CourseDto c)
    {
        _enrolFor = c; _enrolStudent = null;
        _enrolments = (await Fetch(() => Api.GetAsync<List<CourseEnrolmentDto>>($"academics/courses/{c.Id}/enrolments"))).Value ?? [];
        _lookup = (await Fetch(() => Api.GetAsync<List<LookupItem>>("students/lookup"))).Value ?? [];
    }
    private async Task Enrol() { if (await Run(() => Api.PostAsync($"academics/courses/{_enrolFor!.Id}/enrolments", new EnrolStudentRequest(_enrolStudent!.Value)), "Student enrolled.")) await OpenEnrol(_enrolFor!); }
    private async Task Withdraw(CourseEnrolmentDto e) { if (await Run(() => Api.DeleteAsync($"academics/courses/{e.CourseId}/enrolments/{e.StudentId}"), "Enrolment withdrawn.")) await OpenEnrol(_enrolFor!); }
    private async Task AddGrade() { if (await Run(() => Api.PostAsync("academics/grades", new SaveGradeLevelRequest(_gradeName.Trim(), 0)), "Class added.")) { _gradeName = ""; await LoadAsync(); } }

    private GradeLevelDto? _gradeEdit;
    private string _geName = "";
    private int _geOrder;
    private void EditGrade(GradeLevelDto g) { (_gradeEdit, _geName, _geOrder) = (g, g.Name, g.SortOrder); }
    private async Task SaveGrade()
    {
        if (_gradeEdit is not { } g) return;
        if (await Run(() => Api.PutAsync($"academics/grades/{g.Id}", new SaveGradeLevelRequest(_geName.Trim(), _geOrder)), "Class saved.")) { _gradeEdit = null; await LoadAsync(); }
    }

    private Guid? _yearId;
    private void NewYear() { (_yearId, _yearName, _yCurrent) = (null, string.Empty, false); (_yStart, _yEnd) = (DateOnly.FromDateTime(DateTime.Today), DateOnly.FromDateTime(DateTime.Today.AddMonths(10))); _yearOpen = true; }
    private void EditYear(AcademicYearDto y) { (_yearId, _yearName, _yStart, _yEnd, _yCurrent) = (y.Id, y.Name, y.StartDate, y.EndDate, y.IsCurrent); _yearOpen = true; }

    private sealed record Confirmation(string Title, string Text, Func<Task> Action, string Done);
    private Confirmation? _confirm;
    private void Confirm(string title, string text, Func<Task> action, string done) => _confirm = new(title, text, action, done);
    private async Task RunConfirm()
    {
        if (_confirm is not { } c) return;
        if (await Run(c.Action, c.Done)) { _confirm = null; await LoadAsync(); }
        else _confirm = null;
    }
    private async Task SaveYear()
    {
        var req = new SaveAcademicYearRequest(_yearName, _yStart, _yEnd, _yCurrent);
        if (await Run(() => _yearId is null ? Api.PostAsync("academics/years", req) : Api.PutAsync($"academics/years/{_yearId}", req), "Academic year saved.")) { _yearOpen = false; await LoadAsync(); }
    }
    private Guid? _termId;
    private void OpenTerm(AcademicYearDto y) { (_termFor, _termId) = (y, null); _text = ""; (_yStart, _yEnd) = (y.StartDate, y.EndDate); }
    private void EditTerm(AcademicYearDto y, TermDto t) { (_termFor, _termId, _text, _yStart, _yEnd) = (y, t.Id, t.Name, t.StartDate, t.EndDate); }
    private async Task SaveTerm()
    {
        var req = new SaveTermRequest(_text, _yStart, _yEnd);
        var ok = _termId is { } id
            ? await Run(() => Api.PutAsync($"academics/terms/{id}", req), "Term saved.")
            : await Run(() => Api.PostAsync($"academics/years/{_termFor!.Id}/terms", req), "Term added.");
        if (ok) { (_termFor, _termId) = (null, null); await LoadAsync(); }
    }

    // Rename a chapter or topic in place (order is kept).
    private sealed record Rename(string Title, Func<string, Task> Save);
    private Rename? _rename;
    private void RenameChapter(ChapterDto c) { _text = c.Title; _rename = new("Rename chapter", t => Api.PutAsync($"academics/chapters/{c.Id}", new SaveChapterRequest(t, c.SortOrder))); }
    private void RenameTopic(TopicDto tp) { _text = tp.Title; _rename = new("Rename topic", t => Api.PutAsync($"academics/topics/{tp.Id}", new SaveTopicRequest(t, tp.SortOrder))); }
    private async Task SaveRename()
    {
        if (_rename is not { } r) return;
        if (await Run(() => r.Save(_text), "Saved.")) { _rename = null; await LoadAsync(); }
    }
