@inherits AppComponent
@* Teacher pay (owner decision 2026-11-16): rate per hour from a date; earned = completed classes × the rate on each
   class's day; an admin can correct a payment or remove it with a reason (PaymentEditor). Admins manage; a teacher sees their own. *@
<section class="card fee-panel" id="pay" aria-labelledby="pay-h">
    <div class="card-head">
        <div><h2 id="pay-h">Salary</h2><div class="caption">Rate per hour × hours of completed classes (a class the student missed still counts).</div></div>
        @if (CanManage) { <button class="btn btn-primary btn-sm btn-pill" @onclick="NewPayment"><Icon Name="plus" /> Record payment</button> }
    </div>
    <DataView Loading="_p is null && _error is null" Error="_error" OnRetry="Load">
        @if (_p is { } p)
        {
            <div class="rate-line">
                @if (p.CurrentRate is { } r) { <span>Rate <strong>@Money.Format(r, p.CurrencyCode)</strong> per hour</span> }
                else { <span class="muted">No rate per hour yet: classes are not counted until one is set.</span> }
                @if (CanManage) { <button type="button" class="btn btn-ghost btn-sm" @onclick="OpenRate">@(p.CurrentRate is null ? "Set rate" : "Change rate")</button> }
            </div>
            <MetricStrip AriaLabel="Salary figures" Items="@([
                new("This month", Money.Format(p.EarnedThisMonth, p.CurrencyCode), $"{Money.Hours(p.HoursThisMonth)} taught", "calendar"),
                new("Earned to date", Money.Format(p.EarnedAllTime, p.CurrencyCode), $"{Money.Hours(p.HoursAllTime)} taught", "trending-up"),
                new("Paid", Money.Format(p.Paid, p.CurrencyCode), $"{p.Payments.Count(x => !x.Voided)} payment(s)", "check-circle"),
                new(p.Due < 0 ? "Paid in advance" : "Still to pay", Money.Format(Math.Abs(p.Due), p.CurrencyCode), "earned to date − paid", "wallet"),
            ])" />
            @if (p.UnratedClasses > 0) { <p class="fee-warn" role="status"><Icon Name="alert" /> @p.UnratedClasses completed @(p.UnratedClasses == 1 ? "class is" : "classes are") before the first rate and not counted. Set a rate from an earlier date to include them.</p> }
            @if (p.Rates.Count > 1 || (CanManage && p.Rates.Count > 0))
            {
                @* Admins can remove a rate entered by mistake; pay is recalculated with the rate before it. *@
                <details class="pay-rates"><summary class="small">Rate history</summary>
                    <ul class="list small">@foreach (var hr in p.Rates)
                    {
                        <li class="row-between"><span>From @hr.EffectiveFrom.ToString("d MMM yyyy")</span>
                            <span class="row"><strong>@Money.Format(hr.HourlyRate, p.CurrencyCode) / h</strong>
                                @if (CanManage && hr.Id != Guid.Empty) { <button type="button" class="icon-btn" title="Remove this rate" aria-label="@($"Remove the rate from {hr.EffectiveFrom:d MMM yyyy}")" @onclick="() => RemoveRate(hr)" disabled="@Busy"><Icon Name="trash" /></button> }</span></li>
                    }</ul>
                    @if (CanManage) { <p class="caption">Removing a rate recalculates pay with the rate before it. Salary already paid is not changed.</p> }
                </details>
            }
            <h3 class="pay-h3">Payments</h3>
            @if (p.Payments.Count == 0) { <InlineEmpty Icon="wallet" Text="No salary payments recorded yet." /> }
            else
            {
                <ul class="list">
                    @foreach (var x in p.Payments)
                    {
                        <li class="pay-row @(x.Voided ? "voided" : "")">
                            <div class="grow">
                                <strong>@Money.Format(x.Amount, p.CurrencyCode)</strong> <span class="caption">@x.PaidOn.ToString("d MMM yyyy") · @StudentFeesPanel.MethodName(x.Method)@(x.Reference is { } rf ? $" · {rf}" : "")</span>
                                @if (x.PeriodFrom is { } pf) { <div class="caption">For @pf.ToString("d MMM")@(x.PeriodTo is { } pt ? $" – {pt:d MMM yyyy}" : "")</div> }
                                @if (x.Note is { } n) { <div class="caption">@n</div> }
                                @if (x.Voided) { <div class="caption">Removed: @x.VoidReason</div> }
                            </div>
                            <a class="icon-btn" href="/salary-slips/@TeacherId/@x.Id" title="Salary slip" aria-label="@($"Salary slip for {Money.Format(x.Amount, p.CurrencyCode)} on {x.PaidOn:d MMM}")"><Icon Name="file" /></a>
                            @if (CanManage && !x.Voided)
                            {
                                <button type="button" class="icon-btn" title="Edit" aria-label="@($"Edit the payment of {Money.Format(x.Amount, p.CurrencyCode)} on {x.PaidOn:d MMM}")" @onclick="() => _editor?.EditSalary(TeacherId, x.Id)"><Icon Name="pencil" /></button>
                                <button type="button" class="icon-btn" title="Delete" aria-label="@($"Remove the payment of {Money.Format(x.Amount, p.CurrencyCode)} on {x.PaidOn:d MMM}")" @onclick="@(() => _editor?.RemoveSalary(TeacherId, x.Id, $"{Money.Format(x.Amount, p.CurrencyCode)} paid on {x.PaidOn:d MMM yyyy}"))"><Icon Name="trash" /></button>
                            }
                        </li>
                    }
                </ul>
            }
        }
    </DataView>
</section>

<Modal @bind-Open="_rateOpen" Title="Rate per hour">
    <div class="form-grid">
        <div class="field"><label for="tr">Pay per hour (@Currency) *</label><input id="tr" class="input" type="number" min="0" step="0.01" inputmode="decimal" @bind="_rate" /></div>
        <div class="field"><label for="tf">From</label><input id="tf" class="input" type="date" @bind="_rateFrom" /><span class="help">Classes from this day are paid at this rate; earlier classes keep their old rate.</span></div>
    </div>
    <div class="form-actions"><button class="btn btn-secondary" @onclick="() => _rateOpen = false">Cancel</button><button class="btn btn-primary" @onclick="SaveRate" disabled="@(Busy || _rate is null)">Save rate</button></div>
</Modal>

<SalaryPaymentDialog Me="Me" @bind-Open="_payOpen" TeacherId="TeacherId" OnSaved="_ => Load()" />

@if (CanManage) { <PaymentEditor @ref="_editor" Me="Me" OnChanged="Load" /> }

@code {
    [Parameter, EditorRequired] public Guid TeacherId { get; set; }
    [Parameter] public bool CanManage { get; set; }
    private TeacherPayDto? _p;
    private ApiException? _error;
    private bool _rateOpen, _payOpen;
    private PaymentEditor? _editor;
    private decimal? _rate;
    private DateOnly? _rateFrom;
    private string Currency => _p?.CurrencyCode ?? "";

    protected override Task OnInitializedAsync() => Load();
    private async Task Load() => (_p, _error) = await Fetch(() => Api.GetAsync<TeacherPayDto>($"teachers/{TeacherId}/pay"));

    private void OpenRate() => (_rate, _rateFrom, _rateOpen) = (_p?.CurrentRate, DateOnly.FromDateTime(Time.ToLocal(DateTime.UtcNow, Tz)), true);

    // The shared salary dialog (also on Fees ▸ Salaries and Finance) fills in what is still owed.
    private void NewPayment() => _payOpen = true;

    private async Task SaveRate()
    {
        if (await Run(() => Api.PutAsync($"teachers/{TeacherId}/pay/rate", new SetTeacherRateRequest(_rate ?? 0, _rateFrom)), "Rate saved.")) { _rateOpen = false; await Load(); }
    }

    private async Task RemoveRate(TeacherPayRateDto r)
    {
        if (await Run(() => Api.DeleteAsync($"teachers/{TeacherId}/pay/rates/{r.Id}"), $"Rate from {r.EffectiveFrom:d MMM yyyy} removed.")) await Load();
    }
}
