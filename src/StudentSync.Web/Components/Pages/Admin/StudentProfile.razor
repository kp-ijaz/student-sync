@page "/students/{Id:guid}"
@attribute [Authorize(Roles = "InstitutionAdmin,Teacher")]
@inherits AppPage

<DataView Loading="_p is null && _error is null" Error="_error" OnRetry="LoadAsync">
    @if (_p is not null)
    {
        @* Profile header with the student's photo (initials when none), as on the mobile profile. *@
        <PageTitle>@_p.Student.FullName · Student Sync</PageTitle>
        <nav class="breadcrumbs" aria-label="Breadcrumb" style="margin-bottom:12px"><a href="@(IsAdmin ? "/admin/students" : "/teacher/students")">Students</a> /</nav>
        <header class="page-header t-greeting home-head person-head">
            <Avatar Name="@_p.Student.FullName" PhotoUrl="@_p.Student.PhotoUrl" Size="xl" Decorative="false" />
            <div class="grow">
                <h1 tabindex="-1">@_p.Student.FullName</h1>
                <div class="caption">@string.Join(" · ", new[] { _p.Student.StudentCode, _p.Student.GradeLevelName ?? "No class", _p.Student.CurriculumName ?? "No syllabus", _p.Student.AcademicYearName, _p.Student.SchoolName, _p.Student.TimeZoneId }.Where(x => !string.IsNullOrWhiteSpace(x)))</div>
            </div>
            <div class="btn-group home-head-actions">
                @if (IsAdmin) { <a class="btn btn-secondary btn-pill" href="#fees"><Icon Name="wallet" /> Fees &amp; hours</a> }
                <a class="btn btn-primary btn-pill" href="/sessions/new?studentId=@Id"><Icon Name="plus" /> Add classes</a>
            </div>
        </header>
        var st = _p.Student;
        <section class="card student-about" aria-labelledby="about-h" style="margin-bottom:16px">
            <h2 id="about-h" style="margin-bottom:12px">About @FirstName(st.FullName)</h2>
            <dl class="kv student-about-facts">
                <div><dt>With the centre</dt><dd>@(st.JoinedOn is { } j ? $"{TimeWithUs(j)} · since {j:d MMM yyyy}" : "Joining date not recorded")</dd></div>
                <div><dt>Class</dt><dd>@(st.GradeLevelName ?? "—")@(st.CurriculumName is { } syllabus ? $" · {syllabus}" : "")</dd></div>
                <div><dt>School</dt><dd>@(st.SchoolName ?? "—")</dd></div>
                <div><dt>Tuition subjects</dt><dd>@if (_subjectNames.Count == 0) { <span class="muted">None yet</span> } else { <span class="pill-list">@foreach (var n in _subjectNames) { <span class="badge blue">@n</span> }</span> }</dd></div>
                @if (IsAdmin)
                {
                    <div><dt>Student phone</dt><dd>@if (st.Phone is { } ph) { <a href="tel:@ph">@ph</a> } else { <span class="muted">—</span> }</dd></div>
                    <div><dt>Parent / guardian</dt><dd>@(st.GuardianName ?? "—")@if (st.GuardianPhone is { } gp) { <text> · </text><a href="tel:@gp">@gp</a> }</dd></div>
                }
            </dl>
        </section>
        @if (IsAdmin && Me is not null) { <div style="margin-bottom:16px"><StudentFeesPanel StudentId="Id" Me="Me" /></div> }
        <ProgressPanel Progress="_p.Progress" />
        @* Older enrolment types are shown only when the student has them (tuition-centre students usually do not). *@
        @if (_p.Courses.Count > 0 || _p.Batches.Count > 0 || _p.Arrangements.Count > 0)
        {
            <div class="grid grid-3" style="margin-top:16px">
                @if (_p.Courses.Count > 0) { <div class="card"><h2 style="margin-bottom:8px">Courses</h2><ul>@foreach (var c in _p.Courses) { <li>@c.Name</li> }</ul></div> }
                @if (_p.Batches.Count > 0) { <div class="card"><h2 style="margin-bottom:8px">Previous group enrolments</h2><ul>@foreach (var b in _p.Batches) { <li>@b.Name</li> }</ul></div> }
                @if (_p.Arrangements.Count > 0) { <div class="card"><h2 style="margin-bottom:8px">Private tuition</h2><ul>@foreach (var a in _p.Arrangements) { <li>@a.Name <span class="caption">@a.Detail</span></li> }</ul></div> }
            </div>
        }
        @if (IsStaff && Me is not null) { <div style="margin-top:16px"><SchoolReportsPanel StudentId="Id" Me="Me" SubjectNames="_subjectNames" /></div> }
        @if (IsAdmin && Me is not null) { <div style="margin-top:16px"><StudentSubjectsPanel StudentId="Id" Me="Me" /></div> }
        @if (IsStaff && Me is not null)
        {
            <section class="card" style="margin-top:16px" aria-labelledby="diag-h">
                <div class="card-head"><div><h2 id="diag-h">Diagnostic assessments</h2><div class="caption">Entry tests that show which subjects and chapters need support. Results are evidence for the learning plan.</div></div>
                    <a class="btn btn-secondary btn-sm" href="/exams/new?purpose=Diagnostic&studentId=@Id"><Icon Name="plus" /> New diagnostic</a></div>
                @if (_diagnostics.Count == 0) { <InlineEmpty Icon="check-square" Text="No diagnostic yet. Create one, then enter the answers from the paper sheet or let the student take it online." /> }
                else
                {
                    <ul class="list">
                        @foreach (var d in _diagnostics)
                        {
                            <li class="row-between">
                                <div><strong><a href="/exams/@d.Id">@d.Title</a></strong><div class="caption">@d.SubjectName · @d.QuestionCount questions · <Badge Style="StatusStyles.For(d.Status)" />@(d.AttemptsUsed > 0 ? (d.MyBestScore is { } sc ? $" · {sc} / {d.TotalMarks}" : " · attempted") : " · not attempted")</div></div>
                                @if (d.LatestAttemptId is { } la) { <a class="btn btn-secondary btn-sm" href="/attempts/@la/result">Breakdown</a> } else if (d.Status != ExamStatus.Draft) { <a class="btn btn-secondary btn-sm" href="/exams/@d.Id/paper-entry">Enter paper answers</a> }
                            </li>
                        }
                    </ul>
                }
            </section>
            <div class="grid grid-2" style="margin-top:16px;align-items:start">
                <LearningNeedsPanel StudentId="Id" Me="Me" />
                <StudentNotesPanel StudentId="Id" Me="Me" />
            </div>
        }
        @if (IsAdmin) { <div class="card" style="margin-top:16px"><h2 style="margin-bottom:8px">Parents &amp; guardians</h2><ul>@foreach (var p in _p.Parents) { <li>@p.Name <span class="caption">@p.Detail</span></li> }</ul>@if (_p.Parents.Count == 0) { <p class="muted small">None linked.</p> }</div> }
        <ClassAgenda Sessions="_sessions" Tz="@Tz" Title="Upcoming classes" Class="profile-agenda" LinkHref="@($"/sessions/new?studentId={Id}")" LinkLabel="Add classes"
                     EmptyTitle="No classes in the next 30 days" EmptyText="Use Add classes to book this student's week." />
    }
</DataView>

@code {
    [Parameter] public Guid Id { get; set; }
    private StudentProfileDto? _p;
    private ApiException? _error;
    private List<SessionListItemDto> _sessions = [];
    private List<ExamListItemDto> _diagnostics = [];
    private List<string> _subjectNames = [];

    private static string FirstName(string name) => name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? name;

    /// <summary>"3 months", "1 year 2 months", "12 days": how long the student has been with the centre.</summary>
    private string TimeWithUs(DateOnly joined)
    {
        var today = DateOnly.FromDateTime(Time.ToLocal(DateTime.UtcNow, Tz));
        if (joined > today) return "Starts soon";
        var months = (today.Year - joined.Year) * 12 + today.Month - joined.Month - (today.Day < joined.Day ? 1 : 0);
        if (months < 1) { var days = today.DayNumber - joined.DayNumber; return days switch { 0 => "Joined today", 1 => "1 day", _ => $"{days} days" }; }
        var (y, m) = (months / 12, months % 12);
        var parts = new List<string>();
        if (y > 0) parts.Add(y == 1 ? "1 year" : $"{y} years");
        if (m > 0) parts.Add(m == 1 ? "1 month" : $"{m} months");
        return string.Join(" ", parts);
    }
    protected override async Task LoadAsync()
    {
        (_p, _error) = await Fetch(() => Api.GetAsync<StudentProfileDto>($"students/{Id}"));
        if (_p is not null && IsStaff && (await Fetch(() => Api.GetAsync<StudentSubjectsDto>($"students/{Id}/subjects"))).Value is { } subjects)
            _subjectNames = subjects.Core.Concat(subjects.ChoiceGroups.SelectMany(g => g.Options.Where(o => g.ChosenSubjectIds.Contains(o.Id)))).Concat(subjects.Additional)
                .Select(s => s.Name).Distinct().ToList();
        if (_p is not null && IsStaff) _diagnostics = (await Fetch(() => Api.GetAsync<List<ExamListItemDto>>($"exams?studentId={Id}&purpose=Diagnostic"))).Value ?? [];
        if (_p is not null) _sessions = (await Fetch(() => Api.GetAsync<List<SessionListItemDto>>($"sessions?studentId={Id}&fromUtc={DateTime.UtcNow:O}&toUtc={DateTime.UtcNow.AddDays(30):O}"))).Value ?? [];
    }
}
