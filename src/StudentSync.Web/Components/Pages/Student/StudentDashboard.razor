@page "/student"
@attribute [Authorize(Roles = "Student")]
@inherits AppPage

@* Student home in the shared home pattern (DESIGN.md "Home pattern", same as the admin and teacher homes): greeting with
   Ask a doubt, shortcut pills, four progress numbers, classes grouped by day with a Join bar for the next one, what needs
   the student, their teachers (each opens their upcoming classes), due assignments and what's new in their classes. *@
<PageTitle>Home · Student Sync</PageTitle>
<HomeGreeting FullName="@Me?.FullName" PhotoUrl="@Me?.PhotoUrl" Tz="@Tz" Caption="@($"times in {Tz}")">
    <Actions><a class="btn btn-primary btn-pill" href="/doubts/new"><Icon Name="help" /> Ask a doubt</a></Actions>
</HomeGreeting>

<DataView Loading="_d is null && _error is null" Error="_error" OnRetry="LoadAsync" LoadingLabel="Loading your day">
    @if (_d is not null)
    {
        var p = _d.Progress;
        <QuickLinks Items="Shortcuts" AriaLabel="Your shortcuts" />
        <MetricStrip AriaLabel="Your progress at a glance" Items="@([
            new("Attendance", p.Attendance.Value, "classes attended", "user-check", "/progress"),
            new("Assignments", p.AssignmentsSubmitted.Value, "handed in", "clipboard-check", "/progress"),
            new("Exam score", p.AverageExamScore.Value, "average of your tests", "check-square", "/progress"),
            new("Doubts", p.OpenDoubts.Value, "waiting for an answer", "help", "/doubts"),
        ])" />

        <div class="home-main">
            <div class="home-stack">
                <ClassAgenda Sessions="Classes" Tz="@Tz" Title="Your classes" LinkHref="/timetable" LinkLabel="Timetable" ShowStudentCount="false"
                             EmptyTitle="No classes booked yet" EmptyText="Your centre books your classes; they will appear here.">
                    @if (_d.NextSession is { } next && JoinRules.JoinableNow(next, DateTime.UtcNow))
                    {
                        var live = next.Status == SessionStatus.Live || (next.StartUtc <= DateTime.UtcNow && next.EndUtc > DateTime.UtcNow);
                        <div class="next-bar @(live ? "live" : "")">
                            <div class="next-bar-text">
                                <span class="agenda-flag @(live ? "live" : "next")">@(live ? "Live now" : "Next class")</span>
                                <strong>@next.Title</strong>
                                <span class="caption">@TeachingRules.DayLabel(next.StartUtc, DateTime.UtcNow, Tz) · @Clock12(next.StartUtc)–@Clock12(next.EndUtc) · @People.ShortName(next.TeacherName)</span>
                            </div>
                            <div class="btn-group">
                                <JoinButton SessionId="next.Id" Live="live" Title="@next.Title" Small="true" />
                            </div>
                        </div>
                    }
                </ClassAgenda>

                <section class="card" aria-labelledby="due-h">
                    <div class="card-head"><h2 id="due-h">Due assignments</h2><a href="/learning">Learning</a></div>
                    @if (_d.DueAssignments.Count == 0)
                    {
                        <p class="all-clear"><Icon Name="check-circle" /> You're all caught up — no assignments due.</p>
                    }
                    else
                    {
                        <div class="stack-sm">@foreach (var a in _d.DueAssignments) { <AssignmentCard Assignment="a" Tz="@Tz" /> }</div>
                    }
                </section>
            </div>

            <div class="home-side">
                @if (Me is not null) { <MyTeachersCard Me="Me" /> }
                <section class="card home-needs" aria-labelledby="needs-h">
                    <div class="card-head"><h2 id="needs-h">Needs you</h2></div>
                    <NeedsList Items="Needs" AllClearText="All caught up. Nothing is waiting for you." />
                </section>

                @if (_d.RecentContent.Count > 0)
                {
                    <section class="card" aria-labelledby="new-h">
                        <div class="card-head"><h2 id="new-h">New in your classes</h2></div>
                        <ul class="activity-list">
                            @foreach (var c in _d.RecentContent)
                            {
                                var section = c.Kind switch { "Recording" => "recordings", "Material" => "materials", _ => "notes" };
                                <li><span class="activity-dot" aria-hidden="true"></span><div><a class="small" href="@($"/sessions/{c.SessionId}?tab={section}")">@c.Title</a><div class="caption">@c.Kind · @c.SessionTitle · @Time.Date(c.AtUtc, Tz)</div></div></li>
                            }
                        </ul>
                    </section>
                }
            </div>
        </div>

    }
</DataView>

@code {
    private static readonly IReadOnlyList<ShortcutItem> Shortcuts =
    [
        new("Timetable", "/timetable", "calendar"),
        new("Subjects", "/subjects", "book-open"),
        new("Learning", "/learning", "graduation"),
        new("Learning plan", "/learning-plan", "target"),
        new("Doubts", "/doubts", "help"),
    ];

    private StudentDashboardDto? _d;
    private ApiException? _error;

    private List<SessionListItemDto> Classes => _d is null ? [] :
        _d.UpcomingSessions.Prepend(_d.NextSession).OfType<SessionListItemDto>().DistinctBy(s => s.Id).OrderBy(s => s.StartUtc).ToList();

    /// <summary>The dashboard returns at most 6 due assignments and 5 open doubts; "6+" says so instead of a wrong total.</summary>
    private List<NeedsList.Item> Needs
    {
        get
        {
            var items = new List<NeedsList.Item>();
            var due = _d!.DueAssignments.Count;
            if (due > 0) items.Add(new(due >= 6 ? "6+" : $"{due}", due == 1 ? "assignment to hand in" : "assignments to hand in", "/learning", Action: "Open"));
            var doubts = _d.OpenDoubts.Count;
            if (doubts > 0) items.Add(new(doubts >= 5 ? "5+" : $"{doubts}", doubts == 1 ? "doubt waiting for an answer" : "doubts waiting for an answer", "/doubts", Warning: false, Action: "View"));
            return items;
        }
    }

    private string Clock12(DateTime utc) => Time.ToLocal(utc, Tz).ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task LoadAsync()
    {
        _error = null;
        (_d, _error) = await Fetch(() => Api.GetAsync<StudentDashboardDto>("dashboard/student"));
    }
}
