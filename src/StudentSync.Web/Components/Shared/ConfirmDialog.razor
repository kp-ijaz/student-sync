@* "Are you sure?" before something is deleted: what will happen, a way back, and one red button. One component for
   every delete in the app (it used to be a copy of the same Modal on each page). *@
<Modal Open="Open" OpenChanged="OpenChanged" Title="@Title">
    <p style="margin-top:0">@if (ChildContent is not null) { @ChildContent } else { @Text }</p>
    <div class="form-actions">
        <button class="btn btn-secondary" @onclick="() => OpenChanged.InvokeAsync(false)">@KeepText</button>
        <button class="btn btn-danger" @onclick="OnConfirm" disabled="@Busy"><Icon Name="trash" /> @ConfirmText</button>
    </div>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "Delete";
    [Parameter] public string KeepText { get; set; } = "Keep it";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
}
