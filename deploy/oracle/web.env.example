# Copy to web.env on the web VM (chmod 600).
# Private address of the API VM (server-to-server calls stay inside the VCN).
Api__BaseUrl=http://<api-private-ip>:8080/
# Public HTTPS address of the API, used in the browser for file, photo and recording links.
Api__PublicBaseUrl=https://<api-host>
# Caddy
APP_HOST=<app-host>
API_HOST=<api-host>
API_UPSTREAM=<api-private-ip>:8080
