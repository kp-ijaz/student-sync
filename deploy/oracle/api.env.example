# Copy to api.env on the API VM (chmod 600). Never commit the real file.
# PostgreSQL in the same compose project; the password is APP_DB_PASSWORD from postgres.env.
ConnectionStrings__Default=Host=postgres;Port=5432;Database=StudentSync;Username=studentsync;Password=<app-db-password>
# At least 32 random characters, e.g. `openssl rand -base64 48`.
Jwt__SigningKey=
# Origin of the web app (browser clients calling the API directly).
Cors__Origins__0=https://<app-host>
