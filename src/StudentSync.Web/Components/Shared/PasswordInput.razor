@* A password (or secret key) box with an eye button to show or hide what is typed (owner request 2026-11-17).
   The button is a real toggle (aria-pressed, "Show password" / "Hide password") and keeps focus on the field. *@
<div class="input-icon has-toggle pw-field">
    @if (ShowLockIcon) { <Icon Name="lock" /> }
    <input @ref="_input" id="@Id" class="input @(ShowLockIcon ? "" : "no-icon")" type="@(_visible ? "text" : "password")" autocomplete="@Autocomplete"
           placeholder="@Placeholder" value="@Value" @oninput="e => ValueChanged.InvokeAsync(e.Value?.ToString())"
           spellcheck="false" autocapitalize="off" aria-describedby="@DescribedBy" />
    <button type="button" class="pw-toggle @(_visible ? "on" : "")" aria-label="@(_visible ? $"Hide {What}" : $"Show {What}")" aria-pressed="@Aria.Bool(_visible)"
            aria-controls="@Id" @onclick="Toggle"><Icon Name="eye" Class="pw-show" /><Icon Name="eye-off" Class="pw-hide" /></button>
</div>

@code {
    private ElementReference _input;
    private bool _visible;
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Autocomplete { get; set; } = "new-password";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? DescribedBy { get; set; }
    /// <summary>What the button names: "password" (default), "key", "token"…</summary>
    [Parameter] public string What { get; set; } = "password";
    [Parameter] public bool ShowLockIcon { get; set; }

    private async Task Toggle()
    {
        _visible = !_visible;
        try { await _input.FocusAsync(preventScroll: true); } catch (JSException) { /* focus is a nicety */ } catch (InvalidOperationException) { }
    }
}
