@* Two things side by side for each of the last few months (for example money in and money out), on one shared scale
   starting at zero. Built from plain elements so it stretches to any card width. A legend names the two colours,
   hovering a bar shows its figure, the newest month is marked, and a table of the same figures is available to screen
   readers. No second axis, no decoration. *@
@if (Months.Count == 0 || Max <= 0)
{
    <InlineEmpty Icon="bar-chart" Text="@EmptyText" />
}
else
{
    <div class="mbars">
        <div class="mbars-legend">
            <span><span class="donut-swatch" style="background:var(--ss-blue)" aria-hidden="true"></span> @FirstLabel</span>
            <span><span class="donut-swatch" style="background:var(--ss-orange-deep)" aria-hidden="true"></span> @SecondLabel</span>
        </div>
        <div class="mbars-plot" role="img" aria-label="@($"{FirstLabel} and {SecondLabel} for the last {Months.Count} months. Figures are in the table that follows.")">
            <div class="mbars-y" aria-hidden="true">
                @for (var g = 3; g >= 0; g--) { <span>@Short(Scale * g / 3m)</span> }
            </div>
            <div class="mbars-cols">
                @for (var i = 0; i < Months.Count; i++)
                {
                    var m = Months[i];
                    <div class="mbars-col @(i == Months.Count - 1 ? "now" : "")">
                        <div class="mbars-pair">
                            <span class="mbars-a" style="height:@Pct(m.First)%" title="@($"{m.Month:MMM yyyy} · {FirstLabel}: {Format(m.First)}")"></span>
                            <span class="mbars-b" style="height:@Pct(m.Second)%" title="@($"{m.Month:MMM yyyy} · {SecondLabel}: {Format(m.Second)}")"></span>
                        </div>
                        <span class="mbars-x">@m.Month.ToString("MMM")</span>
                    </div>
                }
            </div>
        </div>
        <table class="sr-only">
            <caption>@FirstLabel and @SecondLabel by month</caption>
            <thead><tr><th>Month</th><th>@FirstLabel</th><th>@SecondLabel</th></tr></thead>
            <tbody>@foreach (var m in Months) { <tr><td>@m.Month.ToString("MMMM yyyy")</td><td>@Format(m.First)</td><td>@Format(m.Second)</td></tr> }</tbody>
        </table>
    </div>
}

@code {
    public sealed record Point(DateOnly Month, decimal First, decimal Second);

    [Parameter, EditorRequired] public IReadOnlyList<Point> Months { get; set; } = [];
    [Parameter] public string FirstLabel { get; set; } = "In";
    [Parameter] public string SecondLabel { get; set; } = "Out";
    [Parameter] public string EmptyText { get; set; } = "Nothing recorded in these months yet.";
    /// <summary>How a figure is written in tooltips and the table (e.g. money with its currency).</summary>
    [Parameter] public Func<decimal, string> Format { get; set; } = v => v.ToString("N0");

    private decimal Max => Months.Count == 0 ? 0 : Months.Max(m => Math.Max(m.First, m.Second));

    /// <summary>The top of the axis: the largest figure rounded up to a tidy number (1, 2, 3, 5 or 10 × a power of ten), so the three gridlines read cleanly.</summary>
    private decimal Scale
    {
        get
        {
            if (Max <= 0) return 3;
            var step = (decimal)Math.Pow(10, Math.Floor(Math.Log10((double)Max / 3)));
            foreach (var k in new[] { 1m, 2m, 3m, 5m, 10m })
                if (step * k * 3 >= Max) return step * k * 3;
            return step * 30;
        }
    }

    /// <summary>Bar height as a share of the plot; anything above zero stays visible.</summary>
    private string Pct(decimal v) => (v <= 0 ? 0 : Math.Max(1.5, (double)(v / Scale) * 100)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string Short(decimal v) => v >= 1_000_000 ? $"{v / 1_000_000m:0.#}M" : v >= 1_000 ? $"{v / 1_000m:0.#}k" : v.ToString("0");
}
