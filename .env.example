# Copy to .env for local development. .env is git-ignored. Never commit real secrets.
# SQL Server 2022 (docker compose) sa password — must meet SQL Server complexity rules.
MSSQL_SA_PASSWORD=change-me-Strong1!
SQL_PORT=14350
# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=
# Password for the fictional demo accounts created by `seed-demo` (development only).
DEMO_PASSWORD=
# Set to true to force demo users to change password at first sign-in (recommended for shared environments).
DEMO_FORCE_PASSWORD_CHANGE=true
# Optional: enables the AI Class Assistant with Claude. Paid usage — leave empty unless approved.
ANTHROPIC_API_KEY=
