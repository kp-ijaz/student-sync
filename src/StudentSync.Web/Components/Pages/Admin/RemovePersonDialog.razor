@inherits AppComponent
@* Delete a student or teacher (owner requests 2026-11-23, 2026-11-24). The API deletes for good only when nothing was
   recorded for the person; otherwise they become "Deleted": off every working screen, record kept under the Deleted
   filter of their list (where they can be restored). *@
<Modal Open="Open" OpenChanged="OpenChanged" Title="@($"Delete {Name}?")">
    <p style="margin-top:0">@Name will no longer be able to sign in and is removed from every working screen: lists, classes, @(Kind == "student" ? "fees, attendance, exams and reports" : "salaries, subjects, timetables and reports").</p>
    <ul class="small remove-person-facts">
        <li>If nothing was recorded for them yet, they are deleted for good.</li>
        <li>Otherwise their full record is kept in one place only: <strong>@(Kind == "student" ? "Students" : "Teachers") ▸ Deleted</strong>. You can open it there, settle any money still open, or restore them.</li>
        <li>Money already received or paid stays in Finance, so past income and profit do not change.</li>
        <li>Cancel @(Kind == "student" ? "their" : "or hand over their") upcoming classes first.</li>
    </ul>
    <div class="form-actions">
        <button class="btn btn-secondary" @onclick="() => OpenChanged.InvokeAsync(false)">Keep @(Kind)</button>
        <button class="btn btn-danger" @onclick="Remove" disabled="@Busy"><Icon Name="trash" /> Delete @(Kind)</button>
    </div>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    /// <summary>"student" or "teacher".</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "student";
    [Parameter, EditorRequired] public Guid PersonId { get; set; }
    [Parameter] public string Name { get; set; } = "";
    /// <summary>Called after a successful delete or archive.</summary>
    [Parameter] public EventCallback OnRemoved { get; set; }

    private async Task Remove()
    {
        RemovePersonResponse? result = null;
        if (!await Run(async () => result = await Api.DeleteAsync<RemovePersonResponse>($"{Kind}s/{PersonId}"))) return;
        Toasts.Show(result!.Message);
        await OpenChanged.InvokeAsync(false);
        await OnRemoved.InvokeAsync();
    }
}
