@implements IDisposable
@inject ShellState Shell
<header class="page-header">
    <div class="grow">
        @if (Breadcrumb is not null) { <div class="breadcrumbs">@Breadcrumb</div> }
        <h1 tabindex="-1">@Title</h1>
        @if (!string.IsNullOrEmpty(Subtitle)) { <div class="subtitle">@Subtitle</div> }
    </div>
    @if (Actions is not null) { <div class="btn-group">@Actions</div> }
</header>
<PageTitle>@Title · Student Sync</PageTitle>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    // The phone app bar shows this title (as the mobile app does); the h1 below stays for structure and focus.
    protected override void OnParametersSet() => Shell.SetTitle(this, Title);
    public void Dispose() => Shell.Clear(this);
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Breadcrumb { get; set; }
}
