@page "/progress"
@attribute [Authorize(Roles = "Student")]
@inherits AppPage

@* Mirrors the mobile "My progress" screen: attendance ring + lessons attended + active weeks, then every measure,
   each expandable to how it is calculated. Opened from Profile (and the dashboard), not from the side menu. *@
<PageHeader Title="My progress" Subtitle="Built only from your real attendance, submissions, results and doubts.">
    <Breadcrumb><a href="/profile">Profile</a> ›</Breadcrumb>
</PageHeader>
<DataView Loading="_p is null && _error is null" Error="_error" OnRetry="LoadAsync" LoadingLabel="Loading progress">
    @if (_p is not null)
    {
        var a = _p.Attendance;
        var pct = Math.Clamp(a.Percent ?? 0, 0, 100);
        <div style="max-width:760px">
            <HeroCard AriaLabel="Summary">
                <div class="progress-hero">
                    <div class="ring">
                        <svg viewBox="0 0 112 112" aria-hidden="true">
                            <circle cx="56" cy="56" r="47" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="10" />
                            <circle cx="56" cy="56" r="47" fill="none" stroke="#FF9F24" stroke-width="10" stroke-linecap="round"
                                    stroke-dasharray="@Circumference.ToString("0.##", Inv)" stroke-dashoffset="@((Circumference * (1 - pct / 100)).ToString("0.##", Inv))"
                                    style="@(pct == 0 ? "display:none" : null)" />
                        </svg>
                        <div class="ring-text"><span class="ring-value">@a.Value</span><span class="ring-label">@a.Label</span></div>
                    </div>
                    <div class="hero-figures">
                        <div class="hero-figure"><span class="v">@_p.LessonsAttended.Value</span><span class="l">@_p.LessonsAttended.Label</span></div>
                        <div class="hero-figure"><span class="v">@_p.ActiveWeeks.Value</span><span class="l">@_p.ActiveWeeks.Label</span></div>
                    </div>
                </div>
            </HeroCard>

            <SectionHeader Title="All measures" Icon="chart-line" Tone="green" />
            <p class="small muted">Open a measure to see how it is calculated.</p>
            <div class="stack-sm">
                @foreach (var m in Metrics) { <MetricTile Metric="m" /> }
            </div>
            <p class="caption" style="margin-top:16px">Recording views are used only to let you resume playback; they never affect these measures.</p>
        </div>
    }
</DataView>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private static readonly double Circumference = 2 * Math.PI * 47;
    private ProgressDto? _p;
    private ApiException? _error;

    private IEnumerable<MetricDto> Metrics => _p is null ? [] :
        [_p.Attendance, _p.AssignmentsSubmitted, _p.AverageAssignmentMark, _p.AverageExamScore, _p.OpenDoubts, _p.LessonsAttended, _p.ActiveWeeks];

    protected override async Task LoadAsync()
    {
        _error = null;
        (_p, _error) = await Fetch(() => Api.GetAsync<ProgressDto>($"students/{Me!.Id}/progress"));
    }
}
