<Modal Open="Password is not null" OpenChanged="_ => PasswordChanged.InvokeAsync(null)" Title="@Title">
    <div class="stack">
        <p>Share this temporary password securely with the account holder. They must change it when they next sign in. It won't be shown again.</p>
        <div class="info-panel num" style="font-size:18px;font-family:ui-monospace,monospace;user-select:all">@Password</div>
        <div class="form-actions"><button class="btn btn-primary" @onclick="() => PasswordChanged.InvokeAsync(null)">Done</button></div>
    </div>
</Modal>
@code {
    [Parameter] public string? Password { get; set; }
    [Parameter] public string Title { get; set; } = "Account created";
    [Parameter] public EventCallback<string?> PasswordChanged { get; set; }
}
