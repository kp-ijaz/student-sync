@typeparam TValue
@* Segmented: a single choice drawn as a fully rounded track with a gradient pill that slides under the selection.
   Built on native radio inputs (one name per instance), so arrow keys, Tab and screen readers behave as a radio group.
   Usage: <Segmented TValue="string" Options="@([new("upcoming", "Upcoming"), new("past", "Past")])" @bind-Value="_view" Label="Show" /> *@
<div class="seg @Class" role="radiogroup" aria-label="@Label" style="--n:@Options.Count;--i:@SelectedIndex">
    <span class="seg-thumb" aria-hidden="true"></span>
    @for (var i = 0; i < Options.Count; i++)
    {
        var option = Options[i];
        var id = $"{_name}-{i}";
        <input type="radio" id="@id" name="@_name" checked="@(i == SelectedIndex)" @onchange="() => Select(option.Value)" />
        <label for="@id">@if (option.Icon is not null) { <Icon Name="@option.Icon" /> }<span>@option.Label</span></label>
    }
</div>

@code {
    public sealed record Option(TValue Value, string Label, string? Icon = null);

    [Parameter, EditorRequired] public IReadOnlyList<Option> Options { get; set; } = [];
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    /// <summary>Accessible name of the group (required by WCAG for a radio group).</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Class { get; set; }

    private readonly string _name = "seg-" + Guid.NewGuid().ToString("N")[..8];
    private int SelectedIndex => Math.Max(0, Options.ToList().FindIndex(o => EqualityComparer<TValue>.Default.Equals(o.Value, Value)));

    private async Task Select(TValue value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
