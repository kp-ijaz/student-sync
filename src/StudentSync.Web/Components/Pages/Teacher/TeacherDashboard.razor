@page "/teacher"
@attribute [Authorize(Roles = "Teacher")]
@inherits AppPage

@* Teacher home in the shared home pattern (DESIGN.md "Home pattern", same as the admin front desk): greeting with
   Add classes, shortcut pills, four numbers, the week's classes grouped by day with a Join/Prepare bar for the next one,
   what needs the teacher (attendance, grading, doubts, AI drafts), the classes needing attendance and open doubts. *@
<PageTitle>Home · Student Sync</PageTitle>
<HomeGreeting FullName="@Me?.FullName" PhotoUrl="@Me?.PhotoUrl" Tz="@Tz" Caption="@Me?.TenantName">
    <Actions><a class="btn btn-primary btn-pill" href="/sessions/new"><Icon Name="plus" /> Add classes</a></Actions>
</HomeGreeting>

<DataView Loading="_d is null && _error is null" Error="_error" OnRetry="LoadAsync">
    @if (_d is not null)
    {
        <QuickLinks Items="Shortcuts" AriaLabel="Teaching shortcuts" />
        <MetricStrip Items="Metrics" AriaLabel="Your teaching at a glance" />

        <div class="home-main">
            <ClassAgenda Sessions="_week" Tz="@Tz" Title="Your classes" LinkHref="/sessions" LinkLabel="Timetable" ShowTeacher="false"
                         EmptyTitle="No classes this week" EmptyText="Classes the centre books for you appear here.">
                @if (_d.NextSession is { } next)
                {
                    var live = next.Status == SessionStatus.Live || (next.StartUtc <= DateTime.UtcNow && next.EndUtc > DateTime.UtcNow);
                    <div class="next-bar @(live ? "live" : "")">
                        <div class="next-bar-text">
                            <span class="agenda-flag @(live ? "live" : "next")">@(live ? "Live now" : "Next class")</span>
                            <strong>@next.Title</strong>
                            <span class="caption">@TeachingRules.DayLabel(next.StartUtc, DateTime.UtcNow, Tz) · @Clock12(next.StartUtc)–@Clock12(next.EndUtc) · @TeachingRules.DeliveryModeLabel(next.DeliveryMode)</span>
                        </div>
                        <div class="btn-group">
                            @if (_joinUrl is not null)
                            {
                                <a class="btn btn-primary btn-sm btn-pill" href="@_joinUrl" target="_blank" rel="noopener noreferrer"><Icon Name="video" /> @(live ? "Join live class" : "Join class")<span class="sr-only"> (opens in a new tab)</span></a>
                            }
                            <a class="btn btn-secondary btn-sm btn-pill" href="/sessions/@next.Id/prepare">Prepare<span class="sr-only"> @next.Title</span></a>
                        </div>
                    </div>
                }
            </ClassAgenda>

            <div class="home-side">
                <section class="card home-needs" aria-labelledby="needs-h">
                    <div class="card-head"><h2 id="needs-h">Needs you</h2><a href="/teacher/tasks">Tasks</a></div>
                    <NeedsList Items="Needs" />
                    @if (_d.PendingAiApprovals.Count > 0)
                    {
                        <p class="note-line" style="margin-top:12px"><Icon Name="info" /><span>AI drafts are not visible to students until you review, approve and publish them.</span></p>
                    }
                </section>

                @if (_d.PendingAttendance.Any(x => !_marked.Contains(x.Id)) && Me is not null)
                {
                    @* After class: mark attendance here in one tap (the first three; the rest on Tasks). *@
                    <section class="card qa-home" aria-labelledby="qa-home-h">
                        <div class="card-head"><h2 id="qa-home-h">Mark attendance</h2>
                            @if (_d.PendingAttendance.Count(x => !_marked.Contains(x.Id)) > 3) { <a href="/teacher/tasks#attendance">All @_d.PendingAttendance.Count(x => !_marked.Contains(x.Id))</a> }</div>
                        <div class="qa-list">
                            @foreach (var s in _d.PendingAttendance.Where(x => !_marked.Contains(x.Id)).Take(3))
                            {
                                <QuickAttendance @key="s.Id" Session="s" Me="Me" OnSaved="id => _marked.Add(id)" />
                            }
                        </div>
                    </section>
                }

                <section class="card" aria-labelledby="doubts-h">
                    <div class="card-head"><h2 id="doubts-h">Doubts to answer</h2>@if (_openDoubts.Count > 0) { <a href="/teacher/tasks#doubts">All doubts</a> }</div>
                    @if (_openDoubts.Count == 0)
                    {
                        <p class="all-clear"><Icon Name="check-circle" /> No open doubts.</p>
                    }
                    else
                    {
                        <ListGroup AriaLabel="Doubts to answer">
                            @foreach (var d in _openDoubts.Take(3)) { <DoubtRow Doubt="d" Tz="@Tz" /> }
                        </ListGroup>
                    }
                </section>
            </div>
        </div>
    }
</DataView>

@code {
    private readonly HashSet<Guid> _marked = [];
    private static readonly IReadOnlyList<ShortcutItem> Shortcuts =
    [
        new("Timetable", "/sessions", "calendar"),
        new("My students", "/teacher/students", "users"),
        new("Tasks", "/teacher/tasks", "list-checks"),
        new("Availability", "/teacher/availability", "clock"),
        new("Question bank", "/questions", "database"),
    ];

    private TeacherDashboardDto? _d;
    private ApiException? _error;
    private string? _joinUrl;
    private List<DoubtListItemDto> _openDoubts = [];
    private List<SessionListItemDto> _week = [];

    private List<MetricStrip.Item> Metrics
    {
        get
        {
            StatDto? Stat(string key) => _d!.Stats.FirstOrDefault(s => s.Key == key);
            return
            [
                new("Students", Stat("students")?.Value ?? "—", "you teach", "users", "/teacher/students"),
                new("Classes", Stat("week")?.Value ?? "—", "in the next 7 days", "calendar", "/sessions"),
                new("To grade", Stat("grading")?.Value ?? "—", "submissions waiting", "clipboard-check", "/teacher/tasks"),
                new("Doubts", _openDoubts.Count.ToString(), "waiting for your answer", "help", "/teacher/tasks#doubts"),
            ];
        }
    }

    private int _classRequests;

    private List<NeedsList.Item> Needs
    {
        get
        {
            var items = new List<NeedsList.Item>();
            var toMark = _d!.PendingAttendance.Where(x => !_marked.Contains(x.Id)).ToList();
            if (toMark.Count > 0)
                items.Add(new($"{toMark.Count}", toMark.Count == 1 ? "class needs attendance marked" : "classes need attendance marked",
                    toMark.Count == 1 ? AttendanceHref(toMark[0]) : "/teacher/tasks#attendance", Action: "Mark"));
            if (_d.SubmissionsToGrade.Count > 0)
                items.Add(new($"{_d.SubmissionsToGrade.Count}", _d.SubmissionsToGrade.Count == 1 ? "submission to grade" : "submissions to grade", "/teacher/tasks", Action: "Grade"));
            if (_openDoubts.Count > 0)
                items.Add(new($"{_openDoubts.Count}", _openDoubts.Count == 1 ? "doubt to answer" : "doubts to answer", "/teacher/tasks#doubts", Action: "Answer"));
            if (_classRequests > 0)
                items.Add(new($"{_classRequests}", _classRequests == 1 ? "student asks to move a class" : "students ask to move a class", "/class-requests", Action: "Answer"));
            if (_d.PendingAiApprovals.Count > 0)
                items.Add(new($"{_d.PendingAiApprovals.Count}", _d.PendingAiApprovals.Count == 1 ? "AI class draft to review" : "AI class drafts to review",
                    $"/ai/drafts/{_d.PendingAiApprovals[0].DraftId}", Warning: false));
            return items;
        }
    }

    protected override async Task LoadAsync()
    {
        _error = null;
        (_d, _error) = await Fetch(() => Api.GetAsync<TeacherDashboardDto>("dashboard/teacher"));
        if (_d is null) return;
        _classRequests = (await Fetch(() => Api.GetAsync<List<ClassChangeRequestDto>>("class-requests?status=Pending"))).Value?.Count(r => r.SessionStartUtc > DateTime.UtcNow) ?? 0;

        // The list only says a link exists; fetch the class for its URL only when Join is offered right now.
        _joinUrl = null;
        if (_d.NextSession is { } next && TeachingRules.JoinableNow(next, DateTime.UtcNow))
            _joinUrl = (await Fetch(() => Api.GetAsync<SessionDetailDto>($"sessions/{next.Id}"))).Value?.MeetingUrl is { Length: > 0 } url ? url : null;

        _openDoubts = _d.UnresolvedDoubts.Where(d => TeachingRules.IsOpenDoubt(d.Status)).ToList();
        _week = _d.TodaySessions.Concat(_d.UpcomingSessions).Prepend(_d.NextSession).OfType<SessionListItemDto>()
            .Where(s => s.Status != SessionStatus.Cancelled && s.EndUtc > DateTime.UtcNow.AddHours(-12))
            .DistinctBy(s => s.Id).OrderBy(s => s.StartUtc).ToList();
    }

    private string Clock12(DateTime utc) => Time.ToLocal(utc, Tz).ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture);

    private static string AttendanceHref(SessionListItemDto s) => $"/sessions/{s.Id}?tab=attendance";
}
