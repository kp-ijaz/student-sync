@page "/receipts/{Id:guid}"
@inherits AppPage
@* Printable fee receipt (admins, and the student it belongs to — the API refuses anyone else). "Print or save as PDF"
   uses the browser's print dialog; print styles hide the app shell. *@
<PageTitle>Receipt · Student Sync</PageTitle>
<DataView Loading="_r is null && _error is null" Error="_error" OnRetry="LoadAsync">
    @if (_r is { } r)
    {
        <div class="doc-actions no-print"><button class="btn btn-primary" onclick="window.print()"><Icon Name="download" /> Print or save as PDF</button></div>
        <article class="doc card" aria-labelledby="rc-h">
            <header class="doc-head">
                <div><h1 id="rc-h">Fee receipt</h1><div class="caption">No. @r.Number</div></div>
                <div class="doc-from"><strong>@r.InstituteName</strong>@if (r.InstituteEmail is { } e) { <div class="caption">@e</div> }</div>
            </header>
            @if (r.Voided) { <div class="error-panel" role="status"><strong>This payment was removed:</strong> @r.VoidReason</div> }
            <dl class="doc-grid">
                <dt>Received from</dt><dd>@r.StudentName <span class="caption">(@r.StudentCode)</span></dd>
                <dt>Date</dt><dd>@r.PaidOn.ToString("d MMMM yyyy")</dd>
                <dt>For</dt><dd>@r.PackageName · @Money.Hours(r.PackageHours)</dd>
                <dt>Paid by</dt><dd>@MethodName(r.Method)@(r.Reference is { } x ? $" · {x}" : "")</dd>
            </dl>
            <div class="doc-total"><span>Amount received</span><strong>@Money.Format(r.Amount, r.CurrencyCode)</strong></div>
            <dl class="doc-grid small">
                <dt>Package price</dt><dd>@Money.Format(r.PackagePrice, r.CurrencyCode)</dd>
                <dt>Paid so far</dt><dd>@Money.Format(r.PaidOnPackage, r.CurrencyCode)</dd>
                <dt>Still due</dt><dd>@Money.Format(r.BalanceOnPackage, r.CurrencyCode)</dd>
            </dl>
            <footer class="caption doc-foot">@(r.RecordedBy is { } who ? $"Recorded by {who}. " : "")Generated by Student Sync.</footer>
        </article>
    }
</DataView>

@code {
    [Parameter] public Guid Id { get; set; }
    private ReceiptDto? _r;
    private ApiException? _error;
    protected override async Task LoadAsync() => (_r, _error) = await Fetch(() => Api.GetAsync<ReceiptDto>($"receipts/{Id}"));
    private static string MethodName(string m) => m switch { "BankTransfer" => "Bank transfer", "Upi" => "UPI", "Online" => "Online payment", _ => m };
}
